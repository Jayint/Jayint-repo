# ======================================
# RAT 环境变量配置模板
# ======================================
# 使用说明:
# 1. 复制此文件为 .env: cp .env.example .env
# 2. 在 .env 文件中填入真实的配置值
# 3. .env 文件不会被提交到 git (已在 .gitignore 中配置)
# ======================================

# ---------------------------
# LLM API 配置
# ---------------------------

# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# GLM-4 (智谱AI) API
GLM_API_KEY=your_glm_api_key_here
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# 通义千问 (阿里云) API
TONGYI_API_KEY=your_tongyi_api_key_here
TONGYI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------------------------
# GitHub API 配置
# ---------------------------

# GitHub Personal Access Token
# 获取方式: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# ---------------------------
# Weave/WandB 配置 (可选)
# ---------------------------

# WandB API Key (用于实验追踪)
# 获取方式: https://wandb.ai/authorize
WANDB_API_KEY=your_wandb_api_key_here

# Weave 项目名称
# WEAVE_PROJECT=rat

# WandB HTTP 请求超时时间 (秒)
WANDB_HTTP_TIMEOUT=300

# Weave 并行度设置
WEAVE_PARALLELISM=2

# 启用服务器响应缓存
WEAVE_USE_SERVER_CACHE=true

# 缓存大小限制 (默认 1GB)
WEAVE_SERVER_CACHE_SIZE_LIMIT=1000000000

# ---------------------------
# Docker 配置 (可选)
# ---------------------------

# Docker 操作超时时间 (秒)
DOCKER_TIMEOUT=300
