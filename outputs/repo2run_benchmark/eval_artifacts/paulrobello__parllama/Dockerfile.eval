FROM python:3.12
RUN (python -m pip install pytest pytest-xdist poetry || python3 -m pip install pytest pytest-xdist poetry || pip install pytest pytest-xdist poetry)
WORKDIR /app
COPY . /app

ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PIP_DEFAULT_TIMEOUT=300
ENV PIP_RETRIES=5

RUN printf '%s\n' 'Acquire::Retries "5";' 'Acquire::http::Timeout "120";' 'Acquire::https::Timeout "120";' 'Acquire::http::Pipeline-Depth "0";' > /etc/apt/apt.conf.d/99jayint-retries

RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip install -e ".[dev]"' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip install pytest textual-dev' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN python -c "from langchain_core._api import LangChainDeprecationWarning; print('found in langchain_core')"
RUN sed -i 's/from langchain._api import LangChainDeprecationWarning/from langchain_core._api import LangChainDeprecationWarning/' src/parllama/__init__.py
RUN sed -n '105,115p' src/parllama/settings_manager.py
RUN sed -n '580,660p' src/parllama/utils.py
RUN sed -n '549,580p' src/parllama/utils.py
RUN sed -i '549,558s/.*/def get_args() -> Namespace:\n """Parse and return the command line arguments.\n\n Returns:\n The result of parsing the arguments.\n """\n \n # Handle pytest by returning default values\n if "pytest" in sys.modules or "pytest" in sys.argv:\n return Namespace(\n data_dir=None,\n ollama_url=None,\n theme_name=None,\n theme_mode=None,\n starting_tab=None,\n use_last_tab_on_startup=None,\n load_local_models_on_startup=None,\n ps_poll=None,\n auto_name_session=None,\n restore_defaults=False,\n purge_cache=False,\n purge_chats=False,\n purge_prompts=False,\n no_save=False,\n no_chat_save=False,\n )/' src/parllama/utils.py
RUN sed -n '549,560p' src/parllama/utils.py
RUN sed -n '549,590p' src/parllama/utils.py
RUN git config --global --add safe.directory /app
RUN git checkout src/parllama/utils.py
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_13.sh && chmod +x /tmp/jayint_run_13.sh && /bin/sh /tmp/jayint_run_13.sh
