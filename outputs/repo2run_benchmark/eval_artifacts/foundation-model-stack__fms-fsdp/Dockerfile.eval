FROM python:3.10
RUN (python -m pip install pytest pytest-xdist poetry || python3 -m pip install pytest pytest-xdist poetry || pip install pytest pytest-xdist poetry)
WORKDIR /app
COPY . /app

ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PIP_DEFAULT_TIMEOUT=300
ENV PIP_RETRIES=5

RUN printf '%s\n' 'Acquire::Retries "5";' 'Acquire::http::Timeout "120";' 'Acquire::https::Timeout "120";' 'Acquire::http::Pipeline-Depth "0";' > /etc/apt/apt.conf.d/99jayint-retries

RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip install -r requirements.txt' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip install pytest' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN python3.10 -m pip --version
RUN python3.10 -m pip show ibm-fms
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_5.sh && chmod +x /tmp/jayint_run_5.sh && /bin/sh /tmp/jayint_run_5.sh
RUN sed -n '55,65p' /usr/local/lib/python3.10/site-packages/fms/modules/attention.py
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_7.sh && chmod +x /tmp/jayint_run_7.sh && /bin/sh /tmp/jayint_run_7.sh
RUN python3.10 -m pip uninstall ibm-fms -y
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'python3.10 -m pip install ibm-fms==1.2.1' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN sed -n '55,75p' /usr/local/lib/python3.10/site-packages/fms/modules/attention.py
RUN sed -n '55,85p' /usr/local/lib/python3.10/site-packages/fms/modules/attention.py
RUN sed -n '85,110p' /usr/local/lib/python3.10/site-packages/fms/modules/attention.py
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_13.sh && chmod +x /tmp/jayint_run_13.sh && /bin/sh /tmp/jayint_run_13.sh
RUN sed -n '55,70p' /usr/local/lib/python3.10/site-packages/fms/modules/attention.py
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_15.sh && chmod +x /tmp/jayint_run_15.sh && /bin/sh /tmp/jayint_run_15.sh
RUN python3.10 -c "import fms.modules.attention; print('Success: fms.modules.attention imported')"
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_17.sh && chmod +x /tmp/jayint_run_17.sh && /bin/sh /tmp/jayint_run_17.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_18.sh && chmod +x /tmp/jayint_run_18.sh && /bin/sh /tmp/jayint_run_18.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_19.sh && chmod +x /tmp/jayint_run_19.sh && /bin/sh /tmp/jayint_run_19.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_20.sh && chmod +x /tmp/jayint_run_20.sh && /bin/sh /tmp/jayint_run_20.sh
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip install -e .' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
