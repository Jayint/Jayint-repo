FROM python:3.12
RUN (python -m pip install pytest pytest-xdist poetry || python3 -m pip install pytest pytest-xdist poetry || pip install pytest pytest-xdist poetry)
WORKDIR /app
COPY . /app

ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PIP_DEFAULT_TIMEOUT=300
ENV PIP_RETRIES=5

RUN printf '%s\n' 'Acquire::Retries "5";' 'Acquire::http::Timeout "120";' 'Acquire::https::Timeout "120";' 'Acquire::http::Pipeline-Depth "0";' > /etc/apt/apt.conf.d/99jayint-retries

RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip3 install pytest' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip3 install torch charset-normalizer==2.0.4' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN git config --global --add safe.directory /app
RUN mkdir -p /app/_stubs/tensorrt /app/_stubs/tensorrt_llm
RUN touch /app/_stubs/tensorrt/__init__.py /app/_stubs/tensorrt_llm/__init__.py
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip3 install transformers' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_7.sh && chmod +x /tmp/jayint_run_7.sh && /bin/sh /tmp/jayint_run_7.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_8.sh && chmod +x /tmp/jayint_run_8.sh && /bin/sh /tmp/jayint_run_8.sh
RUN mkdir -p /app/_stubs/streaming_llm/pos_shift
RUN printf '%s' 'Y2F0ID4gL2FwcC9fc3R1YnMvc3RyZWFtaW5nX2xsbS9fX2luaXRfXy5weSA8PCAnRU9GJwoiIiJTdHViIGZvciBzdHJlYW1pbmdfbGxtIHBhY2thZ2UuIiIiCkVPRg==' | base64 -d > /tmp/jayint_run_10.sh && chmod +x /tmp/jayint_run_10.sh && /bin/sh /tmp/jayint_run_10.sh
RUN printf '%s' 'Y2F0ID4gL2FwcC9fc3R1YnMvc3RyZWFtaW5nX2xsbS9wb3Nfc2hpZnQvX19pbml0X18ucHkgPDwgJ0VPRicKIiIiU3R1YiBmb3Igc3RyZWFtaW5nX2xsbS5wb3Nfc2hpZnQgcGFja2FnZS4iIiIKRU9G' | base64 -d > /tmp/jayint_run_11.sh && chmod +x /tmp/jayint_run_11.sh && /bin/sh /tmp/jayint_run_11.sh
RUN printf '%s' 'Y2F0ID4gL2FwcC9fc3R1YnMvc3RyZWFtaW5nX2xsbS9wb3Nfc2hpZnQvbW9kaWZ5X2xsYW1hLnB5IDw8ICdFT0YnCiIiIlN0dWIgZm9yIHN0cmVhbWluZ19sbG0ucG9zX3NoaWZ0Lm1vZGlmeV9sbGFtYSBtb2R1bGUuIiIiCgpkZWYgbGxhbWFfcG9zX3NoaWZ0X2F0dGVudGlvbl9mb3J3YXJkKCk6CiAgICAiIiJTdHViIGZ1bmN0aW9uLiIiIgogICAgcGFzcwpFT0Y=' | base64 -d > /tmp/jayint_run_12.sh && chmod +x /tmp/jayint_run_12.sh && /bin/sh /tmp/jayint_run_12.sh
RUN sed -i 's/build_trt_llm()/#build_trt_llm()/' /app/setup.py
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_14.sh && chmod +x /tmp/jayint_run_14.sh && /bin/sh /tmp/jayint_run_14.sh
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip3 install -e /app --no-deps' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_16.sh && chmod +x /tmp/jayint_run_16.sh && /bin/sh /tmp/jayint_run_16.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_17.sh && chmod +x /tmp/jayint_run_17.sh && /bin/sh /tmp/jayint_run_17.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_18.sh && chmod +x /tmp/jayint_run_18.sh && /bin/sh /tmp/jayint_run_18.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_19.sh && chmod +x /tmp/jayint_run_19.sh && /bin/sh /tmp/jayint_run_19.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_20.sh && chmod +x /tmp/jayint_run_20.sh && /bin/sh /tmp/jayint_run_20.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_21.sh && chmod +x /tmp/jayint_run_21.sh && /bin/sh /tmp/jayint_run_21.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_22.sh && chmod +x /tmp/jayint_run_22.sh && /bin/sh /tmp/jayint_run_22.sh
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip3 install transformers==4.57.3' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
