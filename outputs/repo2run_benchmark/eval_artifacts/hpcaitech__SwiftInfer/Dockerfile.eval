RUN printf '%s' '' | base64 -d > /tmp/jayint_run_25.sh && chmod +x /tmp/jayint_run_25.sh && /bin/sh /tmp/jayint_run_25.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_26.sh && chmod +x /tmp/jayint_run_26.sh && /bin/sh /tmp/jayint_run_26.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_27.sh && chmod +x /tmp/jayint_run_27.sh && /bin/sh /tmp/jayint_run_27.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_28.sh && chmod +x /tmp/jayint_run_28.sh && /bin/sh /tmp/jayint_run_28.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_29.sh && chmod +x /tmp/jayint_run_29.sh && /bin/sh /tmp/jayint_run_29.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_30.sh && chmod +x /tmp/jayint_run_30.sh && /bin/sh /tmp/jayint_run_30.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_31.sh && chmod +x /tmp/jayint_run_31.sh && /bin/sh /tmp/jayint_run_31.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_32.sh && chmod +x /tmp/jayint_run_32.sh && /bin/sh /tmp/jayint_run_32.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_33.sh && chmod +x /tmp/jayint_run_33.sh && /bin/sh /tmp/jayint_run_33.sh
