FROM python:3.10
RUN (python -m pip install pytest pytest-xdist poetry || python3 -m pip install pytest pytest-xdist poetry || pip install pytest pytest-xdist poetry)
WORKDIR /app
COPY . /app

ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PIP_DEFAULT_TIMEOUT=300
ENV PIP_RETRIES=5

RUN printf '%s\n' 'Acquire::Retries "5";' 'Acquire::http::Timeout "120";' 'Acquire::https::Timeout "120";' 'Acquire::http::Pipeline-Depth "0";' > /etc/apt/apt.conf.d/99jayint-retries

RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip install pytest==7.4.3 pytest-mock==3.14.0 pytest-cov==4.1.0' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip install pydantic==1.10.14 click redis numpy pandas' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip install -e . --no-deps' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip install pymilvus Pillow pypdfium2 opencv-python requests langdetect psutil scikit-learn minio tritonclient morpheus' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN pip uninstall -y morpheus
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip install python-docx Wand aiohttp python-pptx backoff tqdm opentelemetry-api opentelemetry-sdk opentelemetry-exporter-otlp opentelemetry-instrumentation fsspec fastparquet uvicorn gunicorn nltk tabulate more-itertools pyinstrument python-multipart httpx olefile pyyaml unstructured-client tiktoken tokenizers pypdf pyarrow pytesseract tika elasticsearch langchain langchain-community accelerate huggingface-hub openai onnx fastapi langdetect torch torchvision pydantic==1.10.14 --no-deps' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip install -e client/ --no-deps' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip install lxml multidict aiohttp --force-reinstall' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN JAYINT_APT_ATTEMPT=1; JAYINT_APT_MAX_ATTEMPTS=3; JAYINT_APT_STATUS=1; while [ "$JAYINT_APT_ATTEMPT" -le "$JAYINT_APT_MAX_ATTEMPTS" ]; do rm -rf /var/lib/apt/lists/*; DEBIAN_FRONTEND=noninteractive /bin/sh -lc 'apt-get update && apt-get install -y libgl1 libglib2.0-0' && JAYINT_APT_STATUS=0 && break; JAYINT_APT_STATUS=$?; (apt-get clean >/dev/null 2>&1 || true); rm -rf /var/lib/apt/lists/*; if [ "$JAYINT_APT_ATTEMPT" -eq "$JAYINT_APT_MAX_ATTEMPTS" ]; then exit "$JAYINT_APT_STATUS"; fi; JAYINT_APT_ATTEMPT=$((JAYINT_APT_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_APT_STATUS"
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip install ray' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_11.sh && chmod +x /tmp/jayint_run_11.sh && /bin/sh /tmp/jayint_run_11.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_12.sh && chmod +x /tmp/jayint_run_12.sh && /bin/sh /tmp/jayint_run_12.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_13.sh && chmod +x /tmp/jayint_run_13.sh && /bin/sh /tmp/jayint_run_13.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_14.sh && chmod +x /tmp/jayint_run_14.sh && /bin/sh /tmp/jayint_run_14.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_15.sh && chmod +x /tmp/jayint_run_15.sh && /bin/sh /tmp/jayint_run_15.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_16.sh && chmod +x /tmp/jayint_run_16.sh && /bin/sh /tmp/jayint_run_16.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_17.sh && chmod +x /tmp/jayint_run_17.sh && /bin/sh /tmp/jayint_run_17.sh
RUN printf '%s' 'Y2F0ID4+IHNldHVwLmNmZyA8PCAnRU9GJwoKW3Rvb2w6cHl0ZXN0XQpub3JlY3Vyc2VkaXJzID0gc3JjL3V0aWwvcmF5X3Bvb2xfdGVzdC5weQpFT0Y=' | base64 -d > /tmp/jayint_run_18.sh && chmod +x /tmp/jayint_run_18.sh && /bin/sh /tmp/jayint_run_18.sh
RUN printf '%s' 'Y2F0ID4+IHNldHVwLmNmZyA8PCAnRU9GJwoKW3B5dGVzdF0Kbm9yZWN1cnNlZGlycyA9IHNyYwp0ZXN0cGF0aHMgPSB0ZXN0cwpweXRob25fZmlsZXMgPSB0ZXN0XyoucHkKcHl0aG9uX2NsYXNzZXMgPSBUZXN0KgpweXRob25fZnVuY3Rpb25zID0gdGVzdF8qCkVPRg==' | base64 -d > /tmp/jayint_run_19.sh && chmod +x /tmp/jayint_run_19.sh && /bin/sh /tmp/jayint_run_19.sh
RUN printf '%s' 'Y2F0ID4+IHNldHVwLmNmZyA8PCAnRU9GJwphZGRvcHRzID0gLS1pZ25vcmU9c3JjL3V0aWwvcmF5X3Bvb2xfdGVzdC5weQpFT0Y=' | base64 -d > /tmp/jayint_run_20.sh && chmod +x /tmp/jayint_run_20.sh && /bin/sh /tmp/jayint_run_20.sh
RUN printf '%s' 'Y2F0ID4+IHNldHVwLmNmZyA8PCAnRU9GJwppZ25vcmUgPSBzcmMvdXRpbC9yYXlfcG9vbF90ZXN0LnB5CkVPRg==' | base64 -d > /tmp/jayint_run_21.sh && chmod +x /tmp/jayint_run_21.sh && /bin/sh /tmp/jayint_run_21.sh
RUN printf '%s' 'Y2F0ID4gcHl0ZXN0LmluaSA8PCAnRU9GJwpbcHl0ZXN0XQpub3JlY3Vyc2VkaXJzID0gc3JjCnRlc3RwYXRocyA9IHRlc3RzCnB5dGhvbl9maWxlcyA9IHRlc3RfKi5weQpweXRob25fY2xhc3NlcyA9IFRlc3QqCnB5dGhvbl9mdW5jdGlvbnMgPSB0ZXN0XyoKYWRkb3B0cyA9IC0taWdub3JlPXNyYy91dGlsL3JheV9wb29sX3Rlc3QucHkKRU9G' | base64 -d > /tmp/jayint_run_22.sh && chmod +x /tmp/jayint_run_22.sh && /bin/sh /tmp/jayint_run_22.sh
