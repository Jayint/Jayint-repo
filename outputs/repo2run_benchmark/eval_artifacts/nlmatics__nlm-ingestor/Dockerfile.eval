RUN printf '%s\n' aiohappyeyeballs==2.6.1 aiohttp==3.13.5 aiosignal==1.4.0 aniso8601==10.0.1 annotated-types==0.7.0 anyio==4.13.0 attrs==26.1.0 beautifulsoup4==4.14.3 blinker==1.9.0 bs4==0.0.2 certifi==2026.4.22 click==8.4.0 distro==1.9.0 editdistpy==0.2.0 flask==3.1.3 flask-jsonpify==1.5.0 flask-restful==0.3.10 frozenlist==1.8.0 gunicorn==26.0.0 httpx==0.28.1 idna==3.15 iniconfig==2.3.0 jinja2==3.1.6 joblib==1.5.3 lxml==6.1.0 markupsafe==3.0.3 minio==7.2.20 mistune==2.0.3 msgpack==1.1.2 multidict==6.7.1 nlm-ingestor==0.1.7 nlm-utils==0.1.2 nltk==3.9.4 numpy==2.4.5 openai==2.37.0 packaging==26.2 pandas==3.0.3 pip==26.1.1 pluggy==1.6.0 propcache==0.5.2 pydantic==2.13.4 pydantic-core==2.46.4 pygments==2.20.0 pymongo==4.17.0 pytest==9.0.3 python-dateutil==2.9.0.post0 python-magic==0.4.27 pytz==2026.2 redis==7.4.0 regex==2026.5.9 requests==2.34.2 setuptools==70.0.0 six==1.17.0 sniffio==1.3.1 symspellpy==6.9.0 tika==3.1.0 tiktoken==0.13.0 tqdm==4.67.3 typing-extensions==4.15.0 typing-inspection==0.4.2 unidecode==1.4.0 urllib3==2.7.0 werkzeug==3.1.8 wheel==0.47.0 xxhash==3.7.0 yarl==1.23.0 > /tmp/jayint-pip-constraints.txt
