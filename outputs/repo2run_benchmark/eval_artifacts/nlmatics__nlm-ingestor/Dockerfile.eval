RUN python -m nltk.downloader stopwords punkt punkt_tab
RUN ln -s /app/nlm_ingestor/ingestor /app/ingestor
RUN ln -s /app/nlm_ingestor/ingestor_utils /app/ingestor_utils
RUN chmod +x run.sh
EXPOSE 5001
