# Use the official Ubuntu base image
FROM ubuntu:22.04

# Set environment variables to non-interactive to avoid prompts during installation
ENV DEBIAN_FRONTEND=noninteractive

# Update the package list and install necessary packages
RUN JAYINT_APT_ATTEMPT=1; JAYINT_APT_MAX_ATTEMPTS=3; JAYINT_APT_STATUS=1; while [ "$JAYINT_APT_ATTEMPT" -le "$JAYINT_APT_MAX_ATTEMPTS" ]; do rm -rf /var/lib/apt/lists/*; DEBIAN_FRONTEND=noninteractive /bin/sh -lc 'apt-get update && apt-get install -y software-properties-common && add-apt-repository ppa:deadsnakes/ppa && apt-get update && apt-get install -y python3.9 python3.9-venv python3.9-distutils python3-pip wget git libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*' && JAYINT_APT_STATUS=0 && break; JAYINT_APT_STATUS=$?; (apt-get clean >/dev/null 2>&1 || true); rm -rf /var/lib/apt/lists/*; if [ "$JAYINT_APT_ATTEMPT" -eq "$JAYINT_APT_MAX_ATTEMPTS" ]; then exit "$JAYINT_APT_STATUS"; fi; JAYINT_APT_ATTEMPT=$((JAYINT_APT_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_APT_STATUS"

# Set Python 3.9 as the default python3
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.9 1

# Copy the application files
WORKDIR /app
COPY . /app

# Install pytest and other core tools
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'python3 -m pip install pytest pytest-xdist' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python3 -m pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"

# Install requirements.txt
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'python3 -m pip install -r requirements.txt' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python3 -m pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"

# Install the package in editable mode
RUN printf '%s\n' absl-py==2.3.1 aiohappyeyeballs==2.6.1 aiohttp==3.13.5 aiosignal==1.4.0 albucore==0.0.19 albumentations==1.4.20 altair==5.5.0 annotated-types==0.7.0 antlr4-python3-runtime==4.9.3 anyio==4.12.1 argon2-cffi==25.1.0 argon2-cffi-bindings==25.1.0 arrow==1.4.0 asttokens==3.0.1 async-lru==2.0.5 async-timeout==5.0.1 attrs==26.1.0 babel==2.18.0 beautifulsoup4==4.14.3 black==25.11.0 bleach==6.2.0 blinker==1.9.0 boto3==1.42.97 botocore==1.42.97 braceexpand==0.1.7 brotli==1.2.0 cachetools==6.2.6 certifi==2026.4.22 cffi==2.0.0 charset-normalizer==3.4.7 click==8.1.8 cloudpickle==3.1.2 colorlog==6.10.1 comm==0.2.3 contourpy==1.3.0 cryptography==48.0.0 cycler==0.12.1 datasets==4.5.0 debugpy==1.8.20 decorator==5.3.0 decord==0.6.0 defusedxml==0.7.1 detectron2==0.6 dill==0.4.0 doclayout-yolo==0.0.4 eval-type-backport==0.3.1 evaluate==0.4.6 exceptiongroup==1.3.1 executing==2.2.1 fairscale==0.4.13 fast-langdetect==0.2.0 fastjsonschema==2.21.2 fasttext-wheel==0.9.2 filelock==3.19.1 fonttools==4.60.2 fqdn==1.5.1 frozenlist==1.8.0 fsspec==2025.10.0 ftfy==6.3.1 fvcore==0.1.5.post20221221 gitdb==4.0.12 gitpython==3.1.50 grpcio==1.80.0 h11==0.16.0 hf-xet==1.5.0 httpcore==1.0.9 httpx==0.28.1 huggingface-hub==0.36.2 hydra-core==1.3.2 idna==3.15 importlib-metadata==8.7.1 importlib-resources==6.5.2 iniconfig==2.1.0 iopath==0.1.9 ipykernel==6.31.0 ipython==8.18.1 isoduration==20.11.0 jedi==0.19.2 jinja2==3.1.6 jmespath==1.1.0 joblib==1.5.3 json5==0.14.0 jsonpointer==3.0.0 jsonschema==4.25.1 jsonschema-specifications==2025.9.1 jupyter-client==8.6.3 jupyter-core==5.8.1 jupyter-events==0.12.1 jupyter-lsp==2.3.1 jupyter-server==2.18.2 jupyter-server-terminals==0.5.4 jupyterlab==4.5.7 jupyterlab-pygments==0.3.0 jupyterlab-server==2.28.0 kiwisolver==1.4.7 langdetect==1.0.9 lark==1.3.1 levenshtein==0.27.1 loguru==0.7.3 lxml==6.1.0 magic-pdf==0.10.6 markdown==3.9 markdown-it-py==3.0.0 markupsafe==3.0.3 matplotlib==3.9.4 matplotlib-inline==0.2.2 mdurl==0.1.2 mistune==3.2.1 mpmath==1.3.0 multidict==6.7.1 multiprocess==0.70.18 mypy-extensions==1.1.0 narwhals==2.21.0 nbclient==0.10.2 nbconvert==7.17.1 nbformat==5.10.4 nest-asyncio==1.6.0 networkx==3.2.1 nltk==3.9.2 notebook-shim==0.2.4 numpy==1.26.4 nvidia-cublas-cu12==12.8.4.1 nvidia-cuda-cupti-cu12==12.1.105 nvidia-cuda-nvrtc-cu12==12.1.105 nvidia-cuda-runtime-cu12==12.1.105 nvidia-cudnn-cu12==9.10.2.21 nvidia-cufft-cu12==11.0.2.54 nvidia-cufile-cu12==1.13.1.3 nvidia-curand-cu12==10.3.2.106 nvidia-cusolver-cu12==11.4.5.107 nvidia-cusparse-cu12==12.1.0.106 nvidia-cusparselt-cu12==0.7.1 nvidia-nccl-cu12==2.27.3 nvidia-nvjitlink-cu12==12.8.93 nvidia-nvtx-cu12==12.1.105 omegaconf==2.3.0 opencv-python==4.13.0.92 opencv-python-headless==4.9.0.80 opt-einsum==3.3.0 overrides==7.7.0 packaging==26.2 paddleocr==3.5.0 paddlepaddle==3.3.1 pandas==2.3.3 pandocfilters==1.5.1 parso==0.8.7 pathspec==1.1.1 pdf2image==1.17.0 pdfminer-six==20231228 pexpect==4.9.0 pillow==11.3.0 platformdirs==4.4.0 pluggy==1.6.0 polars==1.36.1 polars-runtime-32==1.36.1 portalocker==3.2.0 prometheus-client==0.25.0 prompt-toolkit==3.0.52 propcache==0.4.1 protobuf==6.33.6 psutil==7.2.2 ptyprocess==0.7.0 pure-eval==0.2.3 py-cpuinfo==9.0.0 pyarrow==21.0.0 pybind11==3.0.4 pycocotools==2.0.11 pycparser==2.23 pydantic==2.7.4 pydantic-core==2.18.4 pydeck==0.9.2 pygments==2.20.0 pymupdf==1.26.5 pyparsing==3.3.2 pypdfium2==4.30.0 pytest==8.4.2 python-dateutil==2.9.0.post0 python-json-logger==4.0.0 pytokens==0.4.1 pytz==2026.2 pyyaml==6.0.3 pyzmq==27.1.0 rapidfuzz==3.13.0 referencing==0.36.2 regex==2026.1.15 requests==2.32.5 rfc3339-validator==0.1.4 rfc3986-validator==0.1.1 rfc3987-syntax==1.1.0 rich==13.9.4 robust-downloader==0.0.2 rpds-py==0.27.1 s3transfer==0.16.1 safetensors==0.7.0 scikit-learn==1.6.1 scipy==1.13.1 seaborn==0.13.2 send2trash==2.1.0 setuptools==82.0.1 simsimd==6.5.16 six==1.17.0 smmap==5.0.3 soupsieve==2.8.3 stack-data==0.6.3 streamlit==1.50.0 streamlit-drawable-canvas==0.9.3 stringzilla==4.6.1 sympy==1.14.0 tabulate==0.9.0 tenacity==9.1.2 tensorboard==2.20.0 tensorboard-data-server==0.7.2 termcolor==3.1.0 terminado==0.18.1 thop==0.1.1.post2209072238 threadpoolctl==3.6.0 timm==1.0.27 tinycss2==1.4.0 tokenizers==0.15.2 toml==0.10.2 tomli==2.4.1 torch==2.8.0 torchdata==0.7.1 torchtext==0.18.0 torchvision==0.23.0 tornado==6.5.5 tqdm==4.67.3 traitlets==5.15.0 transformers==4.36.2 triton==3.4.0 typing-extensions==4.15.0 typing-inspection==0.4.2 tzdata==2026.2 ultralytics==8.4.51 ultralytics-thop==2.0.19 unimernet==0.1.2 uri-template==1.3.0 urllib3==1.26.20 watchdog==6.0.0 wcwidth==0.7.0 webcolors==24.11.1 webdataset==0.2.100 webencodings==0.5.1 websocket-client==1.9.0 werkzeug==3.1.8 xxhash==3.7.0 yacs==0.1.8 yarl==1.22.0 zipp==3.23.1 > /tmp/jayint-pip-constraints.txt
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'python3 -m pip install -e /app --constraint /tmp/jayint-pip-constraints.txt' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"

# Apply source code patches for Python 3.9 compatibility
RUN sed -i '1s/^/from __future__ import annotations\n/' /app/magic_pdf/data/read_api.py && sed -i '1s/^/from __future__ import annotations\n/' /app/magic_pdf/integrations/rag/type.py

# Fix test configuration file
RUN mkdir -p /app/tests/test_cli/conf && cat > /app/tests/test_cli/conf/conf.py << 'CONFEOF'
import os
github_workspace = os.environ.get('GITHUB_WORKSPACE', '/app')
conf = {
"code_path": github_workspace,
"pdf_dev_path" : github_workspace + "/tests/test_cli/pdf_dev",
"pdf_res_path": "/tmp/magic-pdf",
"jsonl_path": "s3://llm-qatest-pnorm/mineru/test/line1.jsonl",
"s3_pdf_path": "s3://llm-qatest-pnorm/mineru/test/test_rearch_report.pdf"
}
CONFEOF

# Install Pillow, Levenshtein, lxml
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'python3 -m pip install Pillow Levenshtein lxml' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python3 -m pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"

# Install paddlepaddle (use latest available compatible version)
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'python3 -m pip install paddlepaddle' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python3 -m pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"

# Install nltk and opencv-python-headless (compatible version)
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'python3 -m pip install nltk opencv-python-headless==4.8.1.78' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python3 -m pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"

# Reinforce numpy version compatibility
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'python3 -m pip install "numpy>=1.21.6,<2.0.0" --force-reinstall' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python3 -m pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"

# Install doclayout_yolo, eval_type_backport, paddleocr (no-deps)
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'python3 -m pip install doclayout_yolo eval_type_backport paddleocr --no-deps' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python3 -m pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"

# Install psutil
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'python3 -m pip install psutil' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python3 -m pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"

# Install albumentations (compatible version), matplotlib, pandas, py-cpuinfo, seaborn, thop, torchvision
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'python3 -m pip install albumentations<1.4.21 matplotlib pandas py-cpuinfo seaborn thop torchvision "paddlepaddle>=2.0"' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python3 -m pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"

# Reinforce numpy and pydantic versions
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'python3 -m pip install "numpy>=1.21.6,<2.0.0" "pydantic>=2.7.2,<2.8.0" --force-reinstall' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python3 -m pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"

# Install opencv-python-headless (compatible version)
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'python3 -m pip install --force-reinstall --no-deps '"'"'opencv-python-headless<4.10'"'"'' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"

# Install pycocotools
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'python3 -m pip install pycocotools' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python3 -m pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"

# Install detectron2 from git
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'python3 -m pip install git+https://github.com/facebookresearch/detectron2.git' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python3 -m pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"

# Install timm
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'python3 -m pip install timm' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python3 -m pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"

# Install transformers (compatible version)
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'python3 -m pip install "transformers<4.37.0"' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python3 -m pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"

# Install ultralytics
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'python3 -m pip install ultralytics' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python3 -m pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"

# Uninstall opencv-python if installed (keep only headless version)
RUN python3 -m pip uninstall -y opencv-python 2>/dev/null || true

# Reinforce numpy and opencv-python-headless compatibility
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'python3 -m pip install --force-reinstall --no-deps '"'"'numpy>=1.21.6,<2.0.0'"'"' '"'"'opencv-python-headless<4.10'"'"'' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"

# Install unimernet==0.1.2
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'python3 -m pip install unimernet==0.1.2' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python3 -m pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"

# Install fairscale, ftfy, decord, webdataset
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'python3 -m pip install fairscale ftfy decord webdataset' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python3 -m pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"

# Create torchtext stub modules for compatibility
RUN mkdir -p /usr/local/lib/python3.9/site-packages/torchtext/data && cat > /usr/local/lib/python3.9/site-packages/torchtext/__init__.py << 'TORCHTEXTEOF'
# Stub torchtext module for compatibility
__version__ = '0.18.0'

def disable_torchtext_deprecation_warning():
    pass
TORCHTEXTEOF

RUN cat > /usr/local/lib/python3.9/site-packages/torchtext/data/__init__.py << 'TORCHTEXTDATAEOF'
# Stub torchtext.data module for compatibility
class metrics:
    @staticmethod
    def bleu_score(predictions, references):
        return 0.0
TORCHTEXTDATAEOF

# Uninstall torchtext and reinstall torch/torchvision compatible with requirements
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'python3 -m pip install --force-reinstall --index-url https://download.pytorch.org/whl/cpu '"'"'torch>=2.2.2'"'"'' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'python3 -m pip install --force-reinstall torchvision' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"

# Reinforce numpy version after torch reinstall
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'python3 -m pip install --force-reinstall --no-deps '"'"'numpy>=1.21.6,<2.0.0'"'"'' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"

# Final numpy reinforcement
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'python3 -m pip install --force-reinstall --no-deps '"'"'numpy>=1.21.6,<2.0.0'"'"' '"'"'pydantic>=2.7.2,<2.8.0'"'"'' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
