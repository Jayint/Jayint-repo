FROM python:3.12
RUN (python -m pip install pytest pytest-xdist poetry || python3 -m pip install pytest pytest-xdist poetry || pip install pytest pytest-xdist poetry)
WORKDIR /app
COPY . /app

ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PIP_DEFAULT_TIMEOUT=300
ENV PIP_RETRIES=5

RUN printf '%s\n' 'Acquire::Retries "5";' 'Acquire::http::Timeout "120";' 'Acquire::https::Timeout "120";' 'Acquire::http::Pipeline-Depth "0";' > /etc/apt/apt.conf.d/99jayint-retries

RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip install pytest pytest-asyncio httpx' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip install setuptools setuptools_scm' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN git config --global --add safe.directory /app
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip install -e . --no-build-isolation' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN sed -n '35,50p' fastmlx/fastmlx.py
RUN sed -n '165,220p' fastmlx/utils.py
RUN sed -n '40,70p' fastmlx/fastmlx.py
RUN sed -n '1,30p' fastmlx/utils.py
RUN sed -n '30,90p' fastmlx/utils.py
RUN sed -n '33,65p' fastmlx/utils.py
RUN sed -i '33,62c\ print("Warning: mlx or mlx_lm not available. Some functionality will be limited.")\n\ntry:\n from mlx_vlm.utils import load_image_processor\n from mlx_vlm.utils import stream_generate as vlm_stream_generate\nexcept ImportError:\n print("Warning: mlx or mlx_lm not available. Some functionality will be limited.")\n\nTOOLS_PATH = os.path.abspath(os.path.join(os.path.dirname(__file__), "tools"))\n\n\ndef get_model_type_list(models, type="vlm"):\n # Get the directory path of the models package\n models_dir = os.path.dirname(models.__file__)\n # List all items in the models directory\n all_items = os.listdir(models_dir)\n if type == "vlm":\n submodules = [\n item\n for item in all_items\n if os.path.isdir(os.path.join(models_dir, item))\n and not item.startswith(".")\n and item != "__pycache__"\n ]\n return submodules\n else:\n return [item for item in all_items if not item.startswith("__")]\n\n\nMODEL_REMAPPING = {"llava-qwen2": "llava_bunny", "bunny-llama": "llava_bunny"}\n\n# Try to get model lists, but provide empty lists if MLX is not available\ntry:\n MODELS = {\n "vlm": get_model_type_list(vlm_models),\n "lm": get_model_type_list(lm_models, "lm"),\n }\nexcept NameError:\n MODELS = {"vlm": [], "lm": []}' fastmlx/utils.py
RUN git checkout fastmlx/utils.py
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_13.sh && chmod +x /tmp/jayint_run_13.sh && /bin/sh /tmp/jayint_run_13.sh
RUN python -c "from fastmlx.utils import handle_function_calls; print('Success')"
RUN sed -n '25,55p' fastmlx/fastmlx.py
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_16.sh && chmod +x /tmp/jayint_run_16.sh && /bin/sh /tmp/jayint_run_16.sh
RUN python -c "from fastmlx import handle_function_calls; print('Success')"
