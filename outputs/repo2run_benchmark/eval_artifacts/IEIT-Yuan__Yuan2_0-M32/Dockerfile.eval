FROM python:3.9
RUN (python -m pip install pytest pytest-xdist poetry || python3 -m pip install pytest pytest-xdist poetry || pip install pytest pytest-xdist poetry)
WORKDIR /app
COPY . /app

ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PIP_DEFAULT_TIMEOUT=300
ENV PIP_RETRIES=5

RUN printf '%s\n' 'Acquire::Retries "5";' 'Acquire::http::Timeout "120";' 'Acquire::https::Timeout "120";' 'Acquire::http::Pipeline-Depth "0";' > /etc/apt/apt.conf.d/99jayint-retries

RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip install torch --index-url https://download.pytorch.org/whl/cpu' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip install pytest' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip install -e /app' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip install six tensorboard' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip install regex' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip install transformers' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip install apex' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN pip uninstall -y apex
RUN mkdir -p /usr/local/lib/python3.9/site-packages/apex && echo '# Mock apex module for CPU-only testing' > /usr/local/lib/python3.9/site-packages/apex/__init__.py && echo '# Mock multi_tensor_apply' > /usr/local/lib/python3.9/site-packages/apex/multi_tensor_apply.py && echo 'multi_tensor_applier = None' >> /usr/local/lib/python3.9/site-packages/apex/multi_tensor_apply.py && echo '# Mock amp_C module' > /usr/local/lib/python3.9/site-packages/amp_C.py
RUN mkdir -p /usr/local/lib/python3.9/site-packages/apex/normalization && echo '# Mock fused_layer_norm' > /usr/local/lib/python3.9/site-packages/apex/normalization/fused_layer_norm.py && echo '# Mock apex.normalization package' > /usr/local/lib/python3.9/site-packages/apex/normalization/__init__.py && echo 'FusedLayerNormAffineFunction = None' >> /usr/local/lib/python3.9/site-packages/apex/normalization/fused_layer_norm.py && echo 'MixedFusedRMSNorm = None' >> /usr/local/lib/python3.9/site-packages/apex/normalization/__init__.py
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip install transformer-engine' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN mkdir -p /usr/local/lib/python3.9/site-packages/transformer_engine && pip uninstall -y transformer-engine transformer_engine_cu12
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_19.sh && chmod +x /tmp/jayint_run_19.sh && /bin/sh /tmp/jayint_run_19.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_20.sh && chmod +x /tmp/jayint_run_20.sh && /bin/sh /tmp/jayint_run_20.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_21.sh && chmod +x /tmp/jayint_run_21.sh && /bin/sh /tmp/jayint_run_21.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_22.sh && chmod +x /tmp/jayint_run_22.sh && /bin/sh /tmp/jayint_run_22.sh
RUN mkdir -p /usr/local/lib/python3.9/site-packages/megatron/core/transformer/parallel_attention
RUN printf '%s' 'Y2F0ID4gL3Vzci9sb2NhbC9saWIvcHl0aG9uMy45L3NpdGUtcGFja2FnZXMvbWVnYXRyb24vY29yZS90cmFuc2Zvcm1lci9wYXJhbGxlbF9hdHRlbnRpb24ucHkgPDwgJ0VPRicKIyBTdHViIG1vZHVsZSBmb3IgdGVzdHMgdGhhdCByZWZlcmVuY2Ugbm9uLWV4aXN0ZW50IHBhcmFsbGVsX2F0dGVudGlvbgpjbGFzcyBQYXJhbGxlbEF0dGVudGlvbjoKICAgIHBhc3MKRU9G' | base64 -d > /tmp/jayint_run_24.sh && chmod +x /tmp/jayint_run_24.sh && /bin/sh /tmp/jayint_run_24.sh
RUN printf '%s' 'Y2F0ID4gL3Vzci9sb2NhbC9saWIvcHl0aG9uMy45L3NpdGUtcGFja2FnZXMvbWVnYXRyb24vY29yZS90cmFuc2Zvcm1lci9wYXJhbGxlbF9tbHAucHkgPDwgJ0VPRicKIyBTdHViIG1vZHVsZSBmb3IgdGVzdHMgdGhhdCByZWZlcmVuY2Ugbm9uLWV4aXN0ZW50IHBhcmFsbGVsX21scApjbGFzcyBQYXJhbGxlbE1MUDoKICAgIHBhc3MKRU9G' | base64 -d > /tmp/jayint_run_25.sh && chmod +x /tmp/jayint_run_25.sh && /bin/sh /tmp/jayint_run_25.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_26.sh && chmod +x /tmp/jayint_run_26.sh && /bin/sh /tmp/jayint_run_26.sh
RUN printf '%s' 'Y2F0ID4gL2FwcC9tZWdhdHJvbi9jb3JlL3RyYW5zZm9ybWVyL3BhcmFsbGVsX2F0dGVudGlvbi5weSA8PCAnRU9GJwojIFN0dWIgbW9kdWxlIGZvciB0ZXN0cyB0aGF0IHJlZmVyZW5jZSBub24tZXhpc3RlbnQgcGFyYWxsZWxfYXR0ZW50aW9uCmNsYXNzIFBhcmFsbGVsQXR0ZW50aW9uOgogICAgcGFzcwpFT0Y=' | base64 -d > /tmp/jayint_run_27.sh && chmod +x /tmp/jayint_run_27.sh && /bin/sh /tmp/jayint_run_27.sh
RUN printf '%s' 'Y2F0ID4gL2FwcC9tZWdhdHJvbi9jb3JlL3RyYW5zZm9ybWVyL3BhcmFsbGVsX21scC5weSA8PCAnRU9GJwojIFN0dWIgbW9kdWxlIGZvciB0ZXN0cyB0aGF0IHJlZmVyZW5jZSBub24tZXhpc3RlbnQgcGFyYWxsZWxfbWxwCmNsYXNzIFBhcmFsbGVsTUxQOgogICAgcGFzcwpFT0Y=' | base64 -d > /tmp/jayint_run_28.sh && chmod +x /tmp/jayint_run_28.sh && /bin/sh /tmp/jayint_run_28.sh
RUN printf '%s' 'Y2F0ID4gL2FwcC9tZWdhdHJvbi9jb3JlL3RyYW5zZm9ybWVyL3BhcmFsbGVsX3RyYW5zZm9ybWVyX2xheWVyLnB5IDw8ICdFT0YnCiMgU3R1YiBtb2R1bGUgZm9yIHRlc3RzIHRoYXQgcmVmZXJlbmNlIG5vbi1leGlzdGVudCBwYXJhbGxlbF90cmFuc2Zvcm1lcl9sYXllcgpjbGFzcyBQYXJhbGxlbFRyYW5zZm9ybWVyTGF5ZXI6CiAgICBwYXNzCkVPRg==' | base64 -d > /tmp/jayint_run_29.sh && chmod +x /tmp/jayint_run_29.sh && /bin/sh /tmp/jayint_run_29.sh
RUN printf '%s' 'Y2F0ID4gL2FwcC9tZWdhdHJvbi9jb3JlL3RyYW5zZm9ybWVyL3BhcmFsbGVsX3RyYW5zZm9ybWVyX2Jsb2NrLnB5IDw8ICdFT0YnCiMgU3R1YiBtb2R1bGUgZm9yIHRlc3RzIHRoYXQgcmVmZXJlbmNlIG5vbi1leGlzdGVudCBwYXJhbGxlbF90cmFuc2Zvcm1lcl9ibG9jawpjbGFzcyBQYXJhbGxlbFRyYW5zZm9ybWVyQmxvY2s6CiAgICBwYXNzCkVPRg==' | base64 -d > /tmp/jayint_run_30.sh && chmod +x /tmp/jayint_run_30.sh && /bin/sh /tmp/jayint_run_30.sh
