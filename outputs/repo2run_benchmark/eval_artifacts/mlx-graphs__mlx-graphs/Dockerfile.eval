FROM python:3.12
RUN (python -m pip install pytest pytest-xdist poetry || python3 -m pip install pytest pytest-xdist poetry || pip install pytest pytest-xdist poetry)
WORKDIR /app
COPY . /app

ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PIP_DEFAULT_TIMEOUT=300
ENV PIP_RETRIES=5

RUN printf '%s\n' 'Acquire::Retries "5";' 'Acquire::http::Timeout "120";' 'Acquire::https::Timeout "120";' 'Acquire::http::Pipeline-Depth "0";' > /etc/apt/apt.conf.d/99jayint-retries

RUN printf '%s' '' | base64 -d > /tmp/jayint_run_1.sh && chmod +x /tmp/jayint_run_1.sh && /bin/sh /tmp/jayint_run_1.sh
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip install -e ".[test]"' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_3.sh && chmod +x /tmp/jayint_run_3.sh && /bin/sh /tmp/jayint_run_3.sh
RUN mkdir -p /usr/local/lib/python3.12/site-packages/mlx
RUN printf '%s' 'Y2F0ID4gL3Vzci9sb2NhbC9saWIvcHl0aG9uMy4xMi9zaXRlLXBhY2thZ2VzL21seC9fX2luaXRfXy5weSA8PCAnRU9GJwoiIiJNaW5pbWFsIG1seCBzdHViIGZvciBMaW51eCB0ZXN0aW5nLiIiIgpFT0Y=' | base64 -d > /tmp/jayint_run_5.sh && chmod +x /tmp/jayint_run_5.sh && /bin/sh /tmp/jayint_run_5.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_6.sh && chmod +x /tmp/jayint_run_6.sh && /bin/sh /tmp/jayint_run_6.sh
RUN python -c "import mlx.core as mx; print('mlx.core imported successfully'); print(mx.zeros([2, 3]))"
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_8.sh && chmod +x /tmp/jayint_run_8.sh && /bin/sh /tmp/jayint_run_8.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_9.sh && chmod +x /tmp/jayint_run_9.sh && /bin/sh /tmp/jayint_run_9.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_10.sh && chmod +x /tmp/jayint_run_10.sh && /bin/sh /tmp/jayint_run_10.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_11.sh && chmod +x /tmp/jayint_run_11.sh && /bin/sh /tmp/jayint_run_11.sh
RUN mkdir -p /usr/local/lib/python3.12/site-packages/mlx/nn/layers
RUN printf '%s' 'Y2F0ID4gL3Vzci9sb2NhbC9saWIvcHl0aG9uMy4xMi9zaXRlLXBhY2thZ2VzL21seC9ubi9sYXllcnMvX19pbml0X18ucHkgPDwgJ0VPRicKIiIiTWluaW1hbCBtbHgubm4ubGF5ZXJzIHN0dWIgZm9yIExpbnV4IHRlc3RpbmcuIiIiCmZyb20gbWx4Lm5uIGltcG9ydCBNb2R1bGUKRU9G' | base64 -d > /tmp/jayint_run_13.sh && chmod +x /tmp/jayint_run_13.sh && /bin/sh /tmp/jayint_run_13.sh
RUN printf '%s' 'Y2F0ID4gL3Vzci9sb2NhbC9saWIvcHl0aG9uMy4xMi9zaXRlLXBhY2thZ2VzL21seC9ubi9sYXllcnMvYmFzZS5weSA8PCAnRU9GJwoiIiJNaW5pbWFsIG1seC5ubi5sYXllcnMuYmFzZSBzdHViIGZvciBMaW51eCB0ZXN0aW5nLiIiIgpmcm9tIG1seC5ubiBpbXBvcnQgTW9kdWxlCkVPRg==' | base64 -d > /tmp/jayint_run_14.sh && chmod +x /tmp/jayint_run_14.sh && /bin/sh /tmp/jayint_run_14.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_15.sh && chmod +x /tmp/jayint_run_15.sh && /bin/sh /tmp/jayint_run_15.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_16.sh && chmod +x /tmp/jayint_run_16.sh && /bin/sh /tmp/jayint_run_16.sh
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip install torch' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_18.sh && chmod +x /tmp/jayint_run_18.sh && /bin/sh /tmp/jayint_run_18.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_19.sh && chmod +x /tmp/jayint_run_19.sh && /bin/sh /tmp/jayint_run_19.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_20.sh && chmod +x /tmp/jayint_run_20.sh && /bin/sh /tmp/jayint_run_20.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_21.sh && chmod +x /tmp/jayint_run_21.sh && /bin/sh /tmp/jayint_run_21.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_22.sh && chmod +x /tmp/jayint_run_22.sh && /bin/sh /tmp/jayint_run_22.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_23.sh && chmod +x /tmp/jayint_run_23.sh && /bin/sh /tmp/jayint_run_23.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_24.sh && chmod +x /tmp/jayint_run_24.sh && /bin/sh /tmp/jayint_run_24.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_25.sh && chmod +x /tmp/jayint_run_25.sh && /bin/sh /tmp/jayint_run_25.sh
