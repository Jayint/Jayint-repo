FROM python:3.10
RUN (python -m pip install pytest pytest-xdist poetry || python3 -m pip install pytest pytest-xdist poetry || pip install pytest pytest-xdist poetry)
WORKDIR /app
COPY . /app

ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PIP_DEFAULT_TIMEOUT=300
ENV PIP_RETRIES=5

RUN printf '%s\n' 'Acquire::Retries "5";' 'Acquire::http::Timeout "120";' 'Acquire::https::Timeout "120";' 'Acquire::http::Pipeline-Depth "0";' > /etc/apt/apt.conf.d/99jayint-retries

RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip install poetry' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN poetry --version

RUN JAYINT_POETRY_ATTEMPT=1; JAYINT_POETRY_MAX_ATTEMPTS=3; JAYINT_POETRY_STATUS=1; while [ "$JAYINT_POETRY_ATTEMPT" -le "$JAYINT_POETRY_MAX_ATTEMPTS" ]; do poetry install --all-extras && JAYINT_POETRY_STATUS=0 && break; JAYINT_POETRY_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_POETRY_ATTEMPT" -eq "$JAYINT_POETRY_MAX_ATTEMPTS" ]; then exit "$JAYINT_POETRY_STATUS"; fi; JAYINT_POETRY_ATTEMPT=$((JAYINT_POETRY_ATTEMPT + 1)); sleep 10; done; exit "$JAYINT_POETRY_STATUS"

RUN printf '%s' 'ZWNobyAnaW1wb3J0IHN5cwpmcm9tIHBhdGhsaWIgaW1wb3J0IFBhdGgKCiMgQWRkIHNyYyB0byBwYXRoIHNvIHRlc3RzIGNhbiBpbXBvcnQgZnJvbSBzcmMuZmVsYWZheApzeXMucGF0aC5pbnNlcnQoMCwgc3RyKFBhdGgoX19maWxlX18pLnBhcmVudC5wYXJlbnQgLyAic3JjIikpJyA+IHRlc3RzL2NvbmZ0ZXN0LnB5' | base64 -d > /tmp/jayint_eval_run_1.sh && chmod +x /tmp/jayint_eval_run_1.sh && /bin/sh /tmp/jayint_eval_run_1.sh

RUN poetry run python -c "import felafax; print(felafax.__file__)"
RUN sed -i 's/from huggingface_hub import create_repo, HfApi, HfFolder, upload_folder/from huggingface_hub import create_repo, HfApi, upload_folder/' src/felafax/trainer_engine/utils.py
RUN sed -i 's/HfFolder.get_token()/HfApi().get_token()/' src/felafax/trainer_engine/utils.py
RUN poetry run pytest --collect-only -q --disable-warnings
