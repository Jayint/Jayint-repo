FROM python:3.10
RUN (python -m pip install pytest pytest-xdist poetry || python3 -m pip install pytest pytest-xdist poetry || pip install pytest pytest-xdist poetry)
WORKDIR /app
COPY . /app

ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PIP_DEFAULT_TIMEOUT=300
ENV PIP_RETRIES=5

RUN printf '%s\n' 'Acquire::Retries "5";' 'Acquire::http::Timeout "120";' 'Acquire::https::Timeout "120";' 'Acquire::http::Pipeline-Depth "0";' > /etc/apt/apt.conf.d/99jayint-retries

RUN printf '%s\n' absl-py==2.4.0 accelerate==1.13.0 adam-atan2-pytorch==0.3.4 aiofiles==23.2.1 aiohappyeyeballs==2.6.1 aiohttp==3.13.5 aiosignal==1.4.0 alphafold3-pytorch==0.6.11 annotated-doc==0.0.4 annotated-types==0.7.0 anyio==4.13.0 async-timeout==5.0.1 attrs==26.1.0 awscliv2==2.3.1 backports-datetime-fromisoformat==2.0.3 beartype==0.22.9 biopython==1.87 cachetools==7.1.1 certifi==2026.4.22 chanfig==0.0.115 charset-normalizer==3.4.7 click==8.3.3 colt5-attention==0.11.1 cuda-bindings==13.2.0 cuda-pathfinder==1.5.4 cuda-toolkit==13.0.2 danling==0.4.0 datasets==1.1.1 dill==0.4.1 einops==0.8.2 einx==0.4.3 ema-pytorch==0.7.9 environs==15.0.1 exceptiongroup==1.3.1 fair-esm==2.0.0 fastapi==0.136.1 ffmpy==1.0.0 filelock==3.29.0 frame-averaging-pytorch==0.1.2 frozendict==2.4.7 frozenlist==1.8.0 fsspec==2026.4.0 gemmi==0.7.5 gitdb==4.0.12 gitpython==3.1.50 gradio==5.23.1 gradio-client==1.8.0 gradio-molecule3d==0.0.7 groovy==0.1.2 grpcio==1.80.0 h11==0.16.0 hf-xet==1.5.0 httpcore==1.0.9 httpx==0.28.1 huggingface-hub==1.14.0 hyper-connections==0.4.11 idna==3.15 iniconfig==2.3.0 jaxtyping==0.2.38 jinja2==3.1.6 joblib==1.5.3 lazy-imports==1.2.0 lightning==2.6.1 lightning-utilities==0.15.3 lion-pytorch==0.2.4 local-attention==1.11.2 loguru==0.7.3 markdown==3.10.2 markdown-it-py==4.2.0 markupsafe==3.0.3 marshmallow==4.3.0 mdurl==0.1.2 mpmath==1.3.0 multidict==6.7.1 multimolecule==0.1.0 multiprocess==0.70.19 networkx==3.4.2 nimporter==1.1.0 numpy==2.2.6 nvidia-cublas==13.1.1.3 nvidia-cuda-cupti==13.0.85 nvidia-cuda-nvrtc==13.0.88 nvidia-cuda-runtime==13.0.96 nvidia-cudnn-cu13==9.20.0.48 nvidia-cufft==12.0.0.61 nvidia-cufile==1.15.1.6 nvidia-curand==10.4.0.35 nvidia-cusolver==12.0.4.66 nvidia-cusparse==12.6.3.3 nvidia-cusparselt-cu13==0.8.1 nvidia-nccl-cu13==2.29.7 nvidia-nvjitlink==13.0.88 nvidia-nvshmem-cu13==3.4.5 nvidia-nvtx==13.0.85 orjson==3.11.9 packaging==26.2 pandas==2.3.3 pdbeccdutils==0.8.5 pillow==11.3.0 pluggy==1.6.0 polars==1.40.1 polars-runtime-32==1.40.1 propcache==0.5.2 protobuf==7.34.1 psutil==7.2.2 pyarrow==24.0.0 pydantic==2.13.4 pydantic-core==2.46.4 pydub==0.25.1 pygments==2.20.0 pyparsing==3.3.2 pytest==9.0.3 pytest-shard==0.1.2 python-dateutil==2.9.0.post0 python-dotenv==1.2.2 python-multipart==0.0.28 pytorch-lightning==2.6.1 pytz==2026.2 pyyaml==6.0.3 rdkit==2026.3.1 regex==2026.5.9 requests==2.34.2 retrying==1.4.2 rich==15.0.0 rotary-embedding-torch==0.8.9 ruff==0.15.13 safehttpx==0.1.7 safetensors==0.7.0 scikit-learn==1.7.2 scipy==1.13.1 semantic-version==2.10.0 sentencepiece==0.2.1 sh==2.2.2 shellingham==1.5.4 shortuuid==1.0.13 six==1.17.0 smmap==5.0.3 starlette==0.52.1 strenum==0.4.15 sympy==1.14.0 taylor-series-linear-attention==0.1.12 tensorboard==2.20.0 tensorboard-data-server==0.7.2 threadpoolctl==3.6.0 timeout-decorator==0.5.0 tokenizers==0.22.2 tomli==2.4.1 tomlkit==0.13.3 torch==2.12.0 torch-einops-utils==0.0.34 torch-geometric==2.7.0 torchdata==0.11.0 torchmetrics==1.9.0 torchtyping==0.1.5 tqdm==4.67.3 transformers==5.8.1 triton==3.7.0 typeguard==2.13.3 typer==0.25.1 typing-extensions==4.15.0 typing-inspection==0.4.2 tzdata==2026.2 urllib3==2.7.0 uvicorn==0.47.0 wadler-lindig==0.1.7 websockets==15.0.1 werkzeug==3.1.8 xxhash==3.7.0 yarl==1.23.0 > /tmp/jayint-pip-constraints.txt
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'python -m pip install -e ".[test]" pytest-shard --constraint /tmp/jayint-pip-constraints.txt' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'python -m pip install "jaxtyping<0.3.0"' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
