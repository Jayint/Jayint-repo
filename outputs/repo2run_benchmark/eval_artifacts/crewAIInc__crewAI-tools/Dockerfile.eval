FROM python:3.13
RUN (python -m pip install pytest pytest-xdist poetry || python3 -m pip install pytest pytest-xdist poetry || pip install pytest pytest-xdist poetry)
WORKDIR /app
COPY . /app

ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PIP_DEFAULT_TIMEOUT=300
ENV PIP_RETRIES=5

RUN printf '%s\n' 'Acquire::Retries "5";' 'Acquire::http::Timeout "120";' 'Acquire::https::Timeout "120";' 'Acquire::http::Pipeline-Depth "0";' > /etc/apt/apt.conf.d/99jayint-retries

RUN mkdir -p /app/tests/data
RUN printf '%s' 'Y2F0ID4gL2FwcC90ZXN0cy9kYXRhL2VtYmVkZGluZy50eHQgPDwgJ0VPRicKMC4xLCAwLjIsIDAuMywgMC40LCAwLjUsIDAuNiwgMC43LCAwLjgsIDAuOSwgMS4wCkVPRg==' | base64 -d > /tmp/jayint_run_2.sh && chmod +x /tmp/jayint_run_2.sh && /bin/sh /tmp/jayint_run_2.sh
RUN sed -i 's/requires-python = ">=3.10,<=3.13"/requires-python = ">=3.10"/' /app/pyproject.toml
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_4.sh && chmod +x /tmp/jayint_run_4.sh && /bin/sh /tmp/jayint_run_4.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_5.sh && chmod +x /tmp/jayint_run_5.sh && /bin/sh /tmp/jayint_run_5.sh
RUN cd /app && pip install -e .
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_7.sh && chmod +x /tmp/jayint_run_7.sh && /bin/sh /tmp/jayint_run_7.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_8.sh && chmod +x /tmp/jayint_run_8.sh && /bin/sh /tmp/jayint_run_8.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_9.sh && chmod +x /tmp/jayint_run_9.sh && /bin/sh /tmp/jayint_run_9.sh
RUN sed -i 's/from distutils.util import strtobool/def strtobool(val):\n val = val.lower()\n if val in ("y", "yes", "t", "true", "on", "1"):\n return 1\n elif val in ("n", "no", "f", "false", "off", "0"):\n return 0\n raise ValueError("invalid truth value %r" % (val,))/' /app/crewai_tools/tools/file_writer_tool/file_writer_tool.py
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_11.sh && chmod +x /tmp/jayint_run_11.sh && /bin/sh /tmp/jayint_run_11.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_12.sh && chmod +x /tmp/jayint_run_12.sh && /bin/sh /tmp/jayint_run_12.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_13.sh && chmod +x /tmp/jayint_run_13.sh && /bin/sh /tmp/jayint_run_13.sh
RUN python3 -c "import crewai; print(dir(crewai))"
RUN python3 -c "from crewai.tools import BaseTool; print('success')"
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_16.sh && chmod +x /tmp/jayint_run_16.sh && /bin/sh /tmp/jayint_run_16.sh
RUN cd /app && python3 -c "from crewai_tools import BaseTool, tool, BraveSearchTool, SpiderTool; print('Import test passed')"
