FROM python:3.12
RUN (python -m pip install pytest pytest-xdist poetry || python3 -m pip install pytest pytest-xdist poetry || pip install pytest pytest-xdist poetry)
WORKDIR /app
COPY . /app

RUN printf '%s\n' 'Acquire::Retries "5";' 'Acquire::http::Timeout "120";' 'Acquire::https::Timeout "120";' 'Acquire::http::Pipeline-Depth "0";' > /etc/apt/apt.conf.d/99jayint-retries || true

RUN curl --retry 5 --retry-delay 5 --retry-connrefused -sSL https://install.python-poetry.org | python3 -
ENV PATH="/root/.local/bin:$PATH"
RUN /root/.local/bin/poetry --version
RUN cd /app/beaverhabits && /root/.local/bin/poetry install
RUN cd /app && /root/.local/bin/poetry run pytest --collect-only -q --disable-warnings
RUN cd /app/beaverhabits && /root/.local/bin/poetry run pytest /app/tests/ --collect-only -q --disable-warnings
