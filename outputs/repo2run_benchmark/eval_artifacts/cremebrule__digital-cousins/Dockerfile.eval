RUN printf '# Comprehensive predicates stub for bddl compatibility\nclass Predicate:\n pass\n\nclass StatePredicate(Predicate):\n pass\n\nclass GoalPredicate(Predicate):\n pass\n\nclass Inside(Predicate):\n pass\n\nclass NextTo(Predicate):\n pass\n\nclass OnTop(Predicate):\n pass\n\nclass Under(Predicate):\n pass\n\nclass Touching(Predicate):\n pass\n\nclass Covered(Predicate):\n pass\n\nclass Contains(Predicate):\n pass\n\nclass Saturated(Predicate):\n pass\n\nclass Filled(Predicate):\n pass\n\nclass Cooked(Predicate):\n pass\n\nclass Frozen(Predicate):\n pass\n\nclass Heated(Predicate):\n pass\n\nclass Hot(Predicate):\n pass\n\nclass Open(Predicate):\n pass\n\nclass ToggledOn(Predicate):\n pass\n\nclass ToggledOff(Predicate):\n pass\n\nclass OnFire(Predicate):\n pass\n\nclass Attached(Predicate):\n pass\n\nclass AttachedTo(Predicate):\n pass\n\nclass Overlaid(Predicate):\n pass\n\nclass Folded(Predicate):\n pass\n\nclass Unfolded(Predicate):\n pass\n\nclass Draped(Predicate):\n pass\n\nclass Wiped(Predicate):\n pass\n\nclass Soaked(Predicate):\n pass\n\nclass Dusty(Predicate):\n pass\n\nclass Soiled(Predicate):\n pass\n\nclass Stained(Predicate):\n pass\n\nclass Burned(Predicate):\n pass\n\nclass Grounded(Predicate):\n pass\n\nclass Sliced(Predicate):\n pass\n\nclass Diced(Predicate):\n pass\n\nclass Chopped(Predicate):\n pass\n\nclass TurnedOn(Predicate):\n pass\n\nclass TurnedOff(Predicate):\n pass\n\nclass PluggedIn(Predicate):\n pass\n\nclass Unplugged(Predicate):\n pass\n\nclass Loaded(Predicate):\n pass\n\nclass Unloaded(Predicate):\n pass\n\nclass Enabled(Predicate):\n pass\n\nclass Disabled(Predicate):\n pass\n\nclass Disinfected(Predicate):\n pass\n\nclass Deactivated(Predicate):\n pass\n\nclass Reachable(Predicate):\n pass\n\nclass Supports(Predicate):\n pass\n\nclass WallsBetween(Predicate):\n pass\n\nclass InRoom(Predicate):\n pass\n\nclass Close(Predicate):\n pass\n\nclass Apart(Predicate):\n pass\n\nclass Left(Predicate):\n pass\n\nclass Right(Predic