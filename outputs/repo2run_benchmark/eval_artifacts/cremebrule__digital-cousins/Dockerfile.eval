RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip install /tmp/omnigibson_stub' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN mkdir -p /tmp/omnigibson_full/omnigibson/utils /tmp/omnigibson_full/omnigibson/objects
RUN printf '# omnigibson package stub\n' > /tmp/omnigibson_full/omnigibson/__init__.py
RUN printf '# Lazy loader stub\n' > /tmp/omnigibson_full/omnigibson/lazy.py
RUN printf '# transform_utils stub\nclass T:\n pass\n' > /tmp/omnigibson_full/omnigibson/utils/transform_utils.py
RUN printf '# sampling_utils stub\ndef raytest_batch(*args, **kwargs):\n return [], []\n' > /tmp/omnigibson_full/omnigibson/utils/sampling_utils.py
RUN printf '# utils module\n' > /tmp/omnigibson_full/omnigibson/utils/__init__.py
RUN printf '# controllers stub\nclass OperationalSpaceController:\n pass\nclass InverseKinematicsController:\n pass\nclass MultiFingerGripperController:\n pass\n' > /tmp/omnigibson_full/omnigibson/controllers.py
RUN printf '# objects stub\nclass PrimitiveObject:\n pass\n' > /tmp/omnigibson_full/omnigibson/objects.py
RUN printf 'from setuptools import setup, find_packages\nsetup(name="omnigibson", version="0.0.0", packages=find_packages())\n' > /tmp/omnigibson_full/setup.py
RUN mkdir -p /tmp/omnigibson_full/omnigibson/envs
