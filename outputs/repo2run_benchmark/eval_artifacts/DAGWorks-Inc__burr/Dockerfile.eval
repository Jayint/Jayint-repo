FROM python:3.12
RUN (python -m pip install pytest pytest-xdist poetry || python3 -m pip install pytest pytest-xdist poetry || pip install pytest pytest-xdist poetry)
WORKDIR /app
COPY . /app

ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PIP_DEFAULT_TIMEOUT=300
ENV PIP_RETRIES=5

RUN printf '%s\n' 'Acquire::Retries "5";' 'Acquire::http::Timeout "120";' 'Acquire::https::Timeout "120";' 'Acquire::http::Pipeline-Depth "0";' > /etc/apt/apt.conf.d/99jayint-retries

RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip install -e ".[tests]"' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN printf '%s' 'Y2F0ID4gcHl0ZXN0LmluaSA8PCAnRU9GJwpbcHl0ZXN0XQp0ZXN0cGF0aHMgPSB0ZXN0cwphc3luY2lvX21vZGU9YXV0bwpFT0Y=' | base64 -d > /tmp/jayint_run_2.sh && chmod +x /tmp/jayint_run_2.sh && /bin/sh /tmp/jayint_run_2.sh
RUN printf '%s' 'Y2F0ID4gcHl0ZXN0LmluaSA8PCAnRU9GJwpbcHl0ZXN0XQp0ZXN0cGF0aHMgPSB0ZXN0cwpweXRob25wYXRoID0gLgphc3luY2lvX21vZGU9YXV0bwpFT0Y=' | base64 -d > /tmp/jayint_run_3.sh && chmod +x /tmp/jayint_run_3.sh && /bin/sh /tmp/jayint_run_3.sh
