FROM python:3.10
RUN (python -m pip install pytest pytest-xdist poetry || python3 -m pip install pytest pytest-xdist poetry || pip install pytest pytest-xdist poetry)
WORKDIR /app
COPY . /app

ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PIP_DEFAULT_TIMEOUT=300
ENV PIP_RETRIES=5

RUN printf '%s\n' 'Acquire::Retries "5";' 'Acquire::http::Timeout "120";' 'Acquire::https::Timeout "120";' 'Acquire::http::Pipeline-Depth "0";' > /etc/apt/apt.conf.d/99jayint-retries

RUN cd /app && pip3 install -e . --no-deps
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip3 install torch==2.3.0 torchvision==0.18.0 torchaudio==2.3.0 --index-url https://download.pytorch.org/whl/cu121' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip3 install transformers timm einops pytest safetensors pyyaml datasets tokenizers huggingface-hub accelerate ninja scipy scikit-learn pandas matplotlib tqdm requests psutil protobuf sentencepiece ftfy pillow sacremoses open-clip-torch peft webdataset pyarrow cloudpathlib boto3 s3fs aiobotocore sentence-transformers pycocoevalcap loguru rich wandb numpy --upgrade' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN mkdir -p /usr/local/lib/python3.10/site-packages/flash_attn/ops /usr/local/lib/python3.10/site-packages/flash_attn/losses
RUN printf '%s' 'Y2F0ID4gL3Vzci9sb2NhbC9saWIvcHl0aG9uMy4xMC9zaXRlLXBhY2thZ2VzL2ZsYXNoX2F0dG4vX19pbml0X18ucHkgPDwgJ0VPRicKIyBTdHViIG1vZHVsZSBmb3IgZmxhc2hfYXR0bgpFT0Y=' | base64 -d > /tmp/jayint_run_5.sh && chmod +x /tmp/jayint_run_5.sh && /bin/sh /tmp/jayint_run_5.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_6.sh && chmod +x /tmp/jayint_run_6.sh && /bin/sh /tmp/jayint_run_6.sh
RUN printf '%s' 'Y2F0ID4gL3Vzci9sb2NhbC9saWIvcHl0aG9uMy4xMC9zaXRlLXBhY2thZ2VzL2ZsYXNoX2F0dG4vb3BzL19faW5pdF9fLnB5IDw8ICdFT0YnCiMgU3R1YiBmb3IgZmxhc2hfYXR0bi5vcHMKRU9G' | base64 -d > /tmp/jayint_run_7.sh && chmod +x /tmp/jayint_run_7.sh && /bin/sh /tmp/jayint_run_7.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_8.sh && chmod +x /tmp/jayint_run_8.sh && /bin/sh /tmp/jayint_run_8.sh
RUN printf '%s' 'Y2F0ID4gL3Vzci9sb2NhbC9saWIvcHl0aG9uMy4xMC9zaXRlLXBhY2thZ2VzL2ZsYXNoX2F0dG4vb3BzL2Z1c2VkX2RlbnNlLnB5IDw8ICdFT0YnCiMgU3R1YiBmb3IgZnVzZWRfZGVuc2UKY2xhc3MgRnVzZWREZW5zZToKICAgIHBhc3MKRU9G' | base64 -d > /tmp/jayint_run_9.sh && chmod +x /tmp/jayint_run_9.sh && /bin/sh /tmp/jayint_run_9.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_10.sh && chmod +x /tmp/jayint_run_10.sh && /bin/sh /tmp/jayint_run_10.sh
RUN printf '%s' 'Y2F0ID4gL3Vzci9sb2NhbC9saWIvcHl0aG9uMy4xMC9zaXRlLXBhY2thZ2VzL2ZsYXNoX2F0dG4vbG9zc2VzL19faW5pdF9fLnB5IDw8ICdFT0YnCiMgU3R1YiBmb3IgbG9zc2VzCkVPRg==' | base64 -d > /tmp/jayint_run_11.sh && chmod +x /tmp/jayint_run_11.sh && /bin/sh /tmp/jayint_run_11.sh
RUN printf '%s' 'Y2F0ID4gL3Vzci9sb2NhbC9saWIvcHl0aG9uMy4xMC9zaXRlLXBhY2thZ2VzL2ZsYXNoX2F0dG4vbG9zc2VzL2Nyb3NzX2VudHJvcHkucHkgPDwgJ0VPRicKIyBTdHViIGZvciBjcm9zc19lbnRyb3B5CmNsYXNzIENyb3NzRW50cm9weUxvc3M6CiAgICBwYXNzCkVPRg==' | base64 -d > /tmp/jayint_run_12.sh && chmod +x /tmp/jayint_run_12.sh && /bin/sh /tmp/jayint_run_12.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_13.sh && chmod +x /tmp/jayint_run_13.sh && /bin/sh /tmp/jayint_run_13.sh
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip3 install git+https://github.com/luyug/GradCache.git' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN mkdir -p /usr/local/lib/python3.10/site-packages/flash_attn/layers
RUN printf '%s' 'Y2F0ID4gL3Vzci9sb2NhbC9saWIvcHl0aG9uMy4xMC9zaXRlLXBhY2thZ2VzL2ZsYXNoX2F0dG4vbGF5ZXJzL19faW5pdF9fLnB5IDw8ICdFT0YnCiMgU3R1YiBmb3IgZmxhc2hfYXR0bi5sYXllcnMKRU9G' | base64 -d > /tmp/jayint_run_16.sh && chmod +x /tmp/jayint_run_16.sh && /bin/sh /tmp/jayint_run_16.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_17.sh && chmod +x /tmp/jayint_run_17.sh && /bin/sh /tmp/jayint_run_17.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_18.sh && chmod +x /tmp/jayint_run_18.sh && /bin/sh /tmp/jayint_run_18.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_19.sh && chmod +x /tmp/jayint_run_19.sh && /bin/sh /tmp/jayint_run_19.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_20.sh && chmod +x /tmp/jayint_run_20.sh && /bin/sh /tmp/jayint_run_20.sh
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip3 install '"'"'transformers>=4.40,<5.0'"'"'' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_22.sh && chmod +x /tmp/jayint_run_22.sh && /bin/sh /tmp/jayint_run_22.sh
