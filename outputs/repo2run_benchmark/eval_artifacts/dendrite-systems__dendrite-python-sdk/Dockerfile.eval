FROM python:3.9
RUN (python -m pip install pytest pytest-xdist poetry || python3 -m pip install pytest pytest-xdist poetry || pip install pytest pytest-xdist poetry)
WORKDIR /app
COPY . /app

ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PIP_DEFAULT_TIMEOUT=300
ENV PIP_RETRIES=5

RUN printf '%s\n' 'Acquire::Retries "5";' 'Acquire::http::Timeout "120";' 'Acquire::https::Timeout "120";' 'Acquire::http::Pipeline-Depth "0";' > /etc/apt/apt.conf.d/99jayint-retries

RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip install poetry' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN poetry install --with dev
RUN poetry run pytest --collect-only -q --disable-warnings --import-mode=importlib
RUN printf '%s' 'Y2F0ID4+IC9hcHAvcHlwcm9qZWN0LnRvbWwgPDwgJ0VPRicKClt0b29sLnB5dGVzdC5pbmlfb3B0aW9uc10KYXN5bmNpb19kZWZhdWx0X2ZpeHR1cmVfbG9vcF9zY29wZSA9ICJzZXNzaW9uIgpFT0Y=' | base64 -d > /tmp/jayint_run_4.sh && chmod +x /tmp/jayint_run_4.sh && /bin/sh /tmp/jayint_run_4.sh
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_5.sh && chmod +x /tmp/jayint_run_5.sh && /bin/sh /tmp/jayint_run_5.sh
RUN python3 /tmp/pytest_config.py
RUN rm -rf /app/.pytest_cache
RUN printf '%s' 'Y2F0ID4gL2FwcC9weXRlc3QuaW5pIDw8ICdFT0YnCltweXRlc3RdCmFzeW5jaW9fZGVmYXVsdF9maXh0dXJlX2xvb3Bfc2NvcGUgPSBzZXNzaW9uCmltcG9ydC1tb2RlID0gaW1wb3J0bGliCkVPRg==' | base64 -d > /tmp/jayint_run_8.sh && chmod +x /tmp/jayint_run_8.sh && /bin/sh /tmp/jayint_run_8.sh
RUN rm /app/pytest.ini
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_10.sh && chmod +x /tmp/jayint_run_10.sh && /bin/sh /tmp/jayint_run_10.sh
RUN python3 /tmp/update_pyproject.py
RUN poetry run pytest --version
RUN poetry run pytest --help
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_14.sh && chmod +x /tmp/jayint_run_14.sh && /bin/sh /tmp/jayint_run_14.sh
RUN python3 /tmp/update_toml.py
RUN poetry run pytest --collect-only -q --disable-warnings
