FROM python:3.12
RUN (python -m pip install pytest pytest-xdist poetry || python3 -m pip install pytest pytest-xdist poetry || pip install pytest pytest-xdist poetry)
WORKDIR /app
COPY . /app

ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PIP_DEFAULT_TIMEOUT=300
ENV PIP_RETRIES=5

RUN printf '%s\n' 'Acquire::Retries "5";' 'Acquire::http::Timeout "120";' 'Acquire::https::Timeout "120";' 'Acquire::http::Pipeline-Depth "0";' > /etc/apt/apt.conf.d/99jayint-retries

RUN pip install pandas --quiet

RUN cat > tests/__init__.py 2>/dev/null; cat > tests/conftest.py << 'EOFCONFTEST'
import sys
from unittest.mock import MagicMock, patch

mock_openai = MagicMock()
mock_anthropic = MagicMock()

class MockOpenAIProvider:
    def __init__(self, *args, **kwargs):
        self.api_key = kwargs.get('api_key', 'mock-key')
        self.model = kwargs.get('model', 'gpt-4-turbo')
        self.temperature = kwargs.get('temperature', 0)
        self.max_tries = kwargs.get('max_tries', 1)
        self.multiplier = kwargs.get('multiplier', 1)
        self.min_wait = kwargs.get('min_wait', 1)
        self.max_wait = kwargs.get('max_wait', 30)
        self.input_tokens = 0
        self.output_tokens = 0

class MockAnthropicProvider:
    def __init__(self, *args, **kwargs):
        self.api_key = kwargs.get('api_key', 'mock-key')
        self.max_tries = kwargs.get('max_tries', 1)
        self.multiplier = kwargs.get('multiplier', 1)
        self.min_wait = kwargs.get('min_wait', 1)
        self.max_wait = kwargs.get('max_wait', 30)
        self.input_tokens = 0
        self.output_tokens = 0

import databonsai.llm_providers
databonsai.llm_providers.OpenAIProvider = MockOpenAIProvider
databonsai.llm_providers.AnthropicProvider = MockAnthropicProvider
EOFCONFTEST

RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip install -e ".[dev]" pytest --quiet' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
