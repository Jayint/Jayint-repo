FROM python:3.10
RUN (python -m pip install pytest pytest-xdist poetry || python3 -m pip install pytest pytest-xdist poetry || pip install pytest pytest-xdist poetry)
WORKDIR /app
COPY . /app

ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PIP_DEFAULT_TIMEOUT=300
ENV PIP_RETRIES=5

RUN printf '%s\n' 'Acquire::Retries "5";' 'Acquire::http::Timeout "120";' 'Acquire::https::Timeout "120";' 'Acquire::http::Pipeline-Depth "0";' > /etc/apt/apt.conf.d/99jayint-retries

RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip install --upgrade pip setuptools wheel' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip install biotite numpy pandas typing_extensions pydantic tqdm plotly nbformat google-cloud-storage gcsfs gemmi rdkit==2023.9.5 pyarrow omegaconf mmcif eval_type_backport posebusters duckdb cloudpathlib mols2grid six' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN printf '%s\n' aiohappyeyeballs==2.6.2 aiohttp==3.14.1 aiosignal==1.4.0 annotated-types==0.7.0 antlr4-python3-runtime==4.9.3 anywidget==0.11.0 asttokens==3.0.1 async-timeout==5.0.1 attrs==26.1.0 biotite==1.2.0 biotraj==1.2.2 build==1.5.0 cachetools==7.1.4 certifi==2026.5.20 cffi==2.0.0 charset-normalizer==3.4.7 cloudpathlib==0.24.0 colorama==0.4.6 comm==0.2.3 coverage==7.14.1 cryptography==48.0.1 decorator==5.3.1 distlib==0.4.2 duckdb==1.5.3 eval-type-backport==0.4.0 exceptiongroup==1.3.1 execnet==2.1.2 executing==2.2.1 fastjsonschema==2.21.2 filelock==3.29.3 frozenlist==1.8.0 fsspec==2026.3.0 gcsfs==2026.5.0 gemmi==0.7.5 google-api-core==2.31.0 google-auth==2.53.0 google-auth-oauthlib==1.4.0 google-cloud-core==2.6.0 google-cloud-storage==3.11.0 google-cloud-storage-control==1.12.0 google-crc32c==1.8.0 google-resumable-media==2.10.0 googleapis-common-protos==1.75.0 grpc-google-iam-v1==0.14.4 grpcio==1.81.0 grpcio-status==1.81.0 idna==3.18 iniconfig==2.3.0 ipython==8.39.0 ipywidgets==8.1.8 jedi==0.20.0 jinja2==3.1.6 jsonschema==4.26.0 jsonschema-specifications==2025.9.1 jupyter-core==5.9.1 jupyterlab-widgets==3.0.16 markupsafe==3.0.3 matplotlib-inline==0.2.2 mmcif==1.1.1 mols2grid==2.2.0 mpmath==1.3.0 msgpack==1.2.0 multidict==6.7.1 narwhals==2.22.1 nbformat==5.10.4 networkx==3.4.2 numpy==2.2.6 oauthlib==3.3.1 omegaconf==2.3.1 packaging==26.2 pandas==2.3.3 parso==0.8.7 pexpect==4.9.0 pillow==12.2.0 pip==26.1.2 platformdirs==4.10.0 plinder==0.2.15 plotly==6.8.0 pluggy==1.6.0 posebusters==0.3.1 prompt-toolkit==3.0.52 propcache==0.5.2 proto-plus==1.28.0 protobuf==7.35.0 psygnal==0.15.1 ptyprocess==0.7.0 pure-eval==0.2.3 pyarrow==24.0.0 pyasn1==0.6.3 pyasn1-modules==0.4.2 pycparser==3.0 pydantic==2.13.4 pydantic-core==2.46.4 pygments==2.20.0 pyproject-api==1.10.1 pyproject-hooks==1.2.0 pytest==9.0.3 pytest-cov==7.1.0 pytest-xdist==3.8.0 python-dateutil==2.9.0.post0 python-discovery==1.4.0 pytz==2026.2 pyyaml==6.0.3 rdkit==2023.9.5 referencing==0.37.0 requests==2.34.2 requests-oauthlib==2.0.0 rpds-py==0.30.0 scipy==1.15.3 setuptools==70.2.0 setuptools-scm==10.0.5 six==1.17.0 stack-data==0.6.3 sympy==1.14.0 tomli==2.4.1 tomli-w==1.2.0 torch==2.12.0+cpu tox==4.55.1 tqdm==4.68.2 traitlets==5.15.1 typing-extensions==4.15.0 typing-inspection==0.4.2 tzdata==2026.2 urllib3==2.7.0 vcs-versioning==1.1.1 virtualenv==21.4.2 wcwidth==0.8.1 wheel==0.47.0 widgetsnbextension==4.0.15 yarl==1.24.2 > /tmp/jayint-pip-constraints.txt
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip install -e "/app" --no-deps --constraint /tmp/jayint-pip-constraints.txt' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip install pytest pytest-cov pytest-xdist build setuptools_scm tox' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip install torch --index-url https://download.pytorch.org/whl/cpu' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_6.sh && chmod +x /tmp/jayint_run_6.sh && /bin/sh /tmp/jayint_run_6.sh
