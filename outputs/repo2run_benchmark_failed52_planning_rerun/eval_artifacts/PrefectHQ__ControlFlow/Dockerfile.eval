FROM python:3.12
RUN (python -m pip install pytest pytest-xdist poetry || python3 -m pip install pytest pytest-xdist poetry || pip install pytest pytest-xdist poetry)
WORKDIR /app
COPY . /app

ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PIP_DEFAULT_TIMEOUT=300
ENV PIP_RETRIES=5

RUN printf '%s\n' 'Acquire::Retries "5";' 'Acquire::http::Timeout "120";' 'Acquire::https::Timeout "120";' 'Acquire::http::Pipeline-Depth "0";' > /etc/apt/apt.conf.d/99jayint-retries

RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'python -m pip install --upgrade pip setuptools wheel' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN git config --global --add safe.directory /app
RUN printf '%s\n' aiohappyeyeballs==2.6.2 aiohttp==3.14.1 aiosignal==1.4.0 aiosqlite==0.22.1 alembic==1.18.4 amplitude-analytics==1.2.3 annotated-doc==0.0.4 annotated-types==0.7.0 anthropic==0.109.1 anyio==4.13.0 apprise==1.11.0 asgi-lifespan==2.1.0 asttokens==3.0.1 asyncpg==0.31.0 attrs==26.1.0 bcrypt==5.0.0 beartype==0.22.9 beautifulsoup4==4.15.0 build==1.5.0 burner-redis==0.1.7 cachetools==7.1.4 certifi==2026.5.20 cffi==2.0.0 charset-normalizer==3.4.7 chromadb==1.5.9 click==8.4.1 cloudpickle==3.1.2 colorama==0.4.6 controlflow==0.11.4.dev34+gf259fa814 coolname==5.0.0 cronsim==2.7 cryptography==48.0.1 cyclopts==4.17.0 dateparser==1.4.0 decorator==5.3.1 distro==1.9.0 docker==7.1.0 docstring-parser==0.18.0 duckduckgo-search==8.1.1 durationpy==0.10 exceptiongroup==1.3.1 execnet==2.1.2 executing==2.2.1 fastapi==0.136.3 filelock==3.29.3 filetype==1.2.0 flatbuffers==25.12.19 frozenlist==1.8.0 fsspec==2026.4.0 google-auth==2.53.0 google-genai==2.8.0 googleapis-common-protos==1.75.0 graphviz==0.21 greenlet==3.5.1 griffe==2.0.2 griffecli==2.0.2 griffelib==2.0.2 groq==0.37.1 grpcio==1.81.0 h11==0.16.0 h2==4.3.0 hf-xet==1.5.1 hpack==4.1.0 httpcore==1.0.9 httptools==0.8.0 httpx==0.28.1 httpx-sse==0.4.3 huggingface-hub==1.18.0 humanize==4.15.0 hyperframe==6.1.0 idna==3.18 importlib-resources==7.1.0 iniconfig==2.3.0 ipython==9.14.1 ipython-pygments-lexers==1.1.1 jedi==0.20.0 jinja2==3.1.6 jinja2-humanize-extension==0.4.0 jiter==0.15.0 jsonpatch==1.33 jsonpointer==3.1.1 jsonschema==4.26.0 jsonschema-specifications==2025.9.1 kubernetes==36.0.2 langchain-anthropic==1.4.5 langchain-classic==1.0.8 langchain-community==0.4.2 langchain-core==1.4.6 langchain-google-genai==4.2.5 langchain-groq==1.1.3 langchain-openai==1.3.0 langchain-protocol==0.0.16 langchain-text-splitters==1.1.2 langsmith==0.8.14 linkify-it-py==2.1.0 lxml==6.1.1 mako==1.3.12 markdown==3.10.2 markdown-it-py==4.2.0 markdownify==1.2.2 markupsafe==3.0.3 matplotlib-inline==0.2.2 mdit-py-plugins==0.6.1 mdurl==0.1.2 mmh3==5.2.1 multidict==6.7.1 numpy==2.4.6 oauthlib==3.3.1 onnxruntime==1.26.0 openai==2.41.1 opentelemetry-api==1.42.1 opentelemetry-exporter-otlp-proto-common==1.42.1 opentelemetry-exporter-otlp-proto-grpc==1.42.1 opentelemetry-proto==1.42.1 opentelemetry-sdk==1.42.1 opentelemetry-semantic-conventions==0.63b1 orjson==3.11.9 overrides==7.7.0 packaging==26.2 parso==0.8.7 pathspec==1.1.1 pendulum==3.2.0 pexpect==4.9.0 pip==26.1.2 platformdirs==4.10.0 pluggy==1.6.0 prefect==3.7.4 primp==1.3.1 prometheus-client==0.25.0 prompt-toolkit==3.0.52 propcache==0.5.2 protobuf==6.33.6 psutil==7.2.2 ptyprocess==0.7.0 pure-eval==0.2.3 py-key-value-aio==0.4.5 pyasn1==0.6.3 pyasn1-modules==0.4.2 pybase64==1.4.3 pycparser==3.0 pydantic==2.13.4 pydantic-core==2.46.4 pydantic-extra-types==2.11.1 pydantic-settings==2.14.1 pydocket==0.21.1 pygments==2.20.0 pypika==0.51.1 pyproject-hooks==1.2.0 pytest==9.0.3 pytest-asyncio==1.4.0 pytest-env==1.6.0 pytest-rerunfailures==16.3 pytest-sugar==1.1.1 pytest-timeout==2.4.0 pytest-xdist==3.8.0 python-dateutil==2.9.0.post0 python-dotenv==1.2.2 python-json-logger==4.1.0 python-slugify==8.0.4 pytz==2026.2 pyyaml==6.0.3 readchar==4.2.2 redis==8.0.0 referencing==0.37.0 regex==2026.5.9 requests==2.34.2 requests-oauthlib==2.0.0 requests-toolbelt==1.0.0 rfc3339-validator==0.1.4 rich==15.0.0 rich-rst==2.0.1 rpds-py==2026.5.1 ruamel-yaml==0.19.1 ruamel-yaml-clib==0.2.15 semver==3.0.4 setuptools==82.0.1 shellingham==1.5.4 six==1.17.0 sniffio==1.3.1 soupsieve==2.8.4 sqlalchemy==2.0.50 stack-data==0.6.3 starlette==1.3.0 tenacity==9.1.4 termcolor==3.3.0 text-unidecode==1.3 textual==8.2.7 tiktoken==0.13.0 tokenizers==0.23.1 toml==0.10.2 tqdm==4.68.2 traitlets==5.15.1 typer==0.25.1 typing-extensions==4.15.0 typing-inspection==0.4.2 tzdata==2026.2 tzlocal==5.3.1 uc-micro-py==2.0.0 uncalled-for==0.3.2 urllib3==2.7.0 uuid-utils==0.16.0 uvicorn==0.49.0 uvloop==0.22.1 watchfiles==1.2.0 wcwidth==0.8.1 websocket-client==1.9.0 websockets==16.0 wheel==0.47.0 xxhash==3.7.0 yarl==1.24.2 zstandard==0.25.0 > /tmp/jayint-pip-constraints.txt
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip install -e /app --constraint /tmp/jayint-pip-constraints.txt' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip install pytest pytest-asyncio pytest-env pytest-rerunfailures pytest-sugar pytest-timeout pytest-xdist chromadb duckduckgo-search langchain_community langchain_google_genai langchain_groq' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
