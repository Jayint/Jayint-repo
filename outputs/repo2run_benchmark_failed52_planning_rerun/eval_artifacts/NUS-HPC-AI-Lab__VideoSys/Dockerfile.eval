RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'python3.11 -m pip install "numpy<2.0.0" --break-system-packages --index-url https://pypi.org/simple/ --trusted-host pypi.org' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN PYTHONPATH=/app python3.11 -m pytest --collect-only -q --disable-warnings /app/tests --ignore=/app/tests/test_rms_norm.py
RUN printf '%b' '[pytest]\naddopts = --ignore=tests/test_rms_norm.py\n' > /app/pytest.ini
RUN PYTHONPATH=/app python3.11 -m pytest --collect-only -q --disable-warnings /app/tests
RUN cd /app && PYTHONPATH=/app python3.11 -m pytest --collect-only -q --disable-warnings
