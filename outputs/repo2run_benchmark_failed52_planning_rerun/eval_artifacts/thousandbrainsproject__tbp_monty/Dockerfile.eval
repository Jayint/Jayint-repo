FROM python:3.7
RUN (python -m pip install --no-cache-dir --trusted-host pypi.org --trusted-host files.pythonhosted.org pytest pytest-xdist poetry || python3 -m pip install --no-cache-dir --trusted-host pypi.org --trusted-host files.pythonhosted.org pytest pytest-xdist poetry || pip install --no-cache-dir --trusted-host pypi.org --trusted-host files.pythonhosted.org pytest pytest-xdist poetry)
WORKDIR /app
COPY . /app

ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PIP_DEFAULT_TIMEOUT=300
ENV PIP_RETRIES=5

RUN printf '%s\n' 'Acquire::Retries "5";' 'Acquire::http::Timeout "120";' 'Acquire::https::Timeout "120";' 'Acquire::http::Pipeline-Depth "0";' > /etc/apt/apt.conf.d/99jayint-retries

RUN JAYINT_APT_ATTEMPT=1; JAYINT_APT_MAX_ATTEMPTS=3; JAYINT_APT_STATUS=1; while [ "$JAYINT_APT_ATTEMPT" -le "$JAYINT_APT_MAX_ATTEMPTS" ]; do rm -rf /var/lib/apt/lists/*; DEBIAN_FRONTEND=noninteractive /bin/sh -lc 'apt-get update && apt-get install -y libgl1 libglib2.0-0 libjpeg-dev zlib1g-dev curl git wget' && JAYINT_APT_STATUS=0 && break; JAYINT_APT_STATUS=$?; (apt-get clean >/dev/null 2>&1 || true); rm -rf /var/lib/apt/lists/*; if [ "$JAYINT_APT_ATTEMPT" -eq "$JAYINT_APT_MAX_ATTEMPTS" ]; then exit "$JAYINT_APT_STATUS"; fi; JAYINT_APT_ATTEMPT=$((JAYINT_APT_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_APT_STATUS"
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip install --upgrade pip setuptools wheel' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip install importlib_resources "matplotlib<3.8" "numpy<1.24" "pandas<2" "pillow<10" "scikit-image<0.20" "scikit-learn<1.1" "scipy<1.11" "sympy<1.12" "tqdm" "wandb"' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip install torch==1.13.1 torch-geometric pytest' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip install pytest-xdist==2.5.0' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN sed -i 's/setuptools >= 71.0.0/setuptools >= 57.0.0/' /app/pyproject.toml
RUN cd /app && pip install -e . --no-deps
RUN JAYINT_PIP_ATTEMPT=1; JAYINT_PIP_MAX_ATTEMPTS=3; JAYINT_PIP_STATUS=1; while [ "$JAYINT_PIP_ATTEMPT" -le "$JAYINT_PIP_MAX_ATTEMPTS" ]; do PIP_NO_CACHE_DIR=1 /bin/sh -lc 'pip install numpy-quaternion magnum' && JAYINT_PIP_STATUS=0 && break; JAYINT_PIP_STATUS=$?; (python -m pip cache purge >/dev/null 2>&1 || python3 -m pip cache purge >/dev/null 2>&1 || pip cache purge >/dev/null 2>&1 || true); if [ "$JAYINT_PIP_ATTEMPT" -eq "$JAYINT_PIP_MAX_ATTEMPTS" ]; then exit "$JAYINT_PIP_STATUS"; fi; JAYINT_PIP_ATTEMPT=$((JAYINT_PIP_ATTEMPT + 1)); sleep 5; done; exit "$JAYINT_PIP_STATUS"
RUN mkdir -p /usr/local/lib/python3.7/site-packages/habitat_sim && touch /usr/local/lib/python3.7/site-packages/habitat_sim/__init__.py
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_15.sh && chmod +x /tmp/jayint_run_15.sh && /bin/sh /tmp/jayint_run_15.sh
RUN mkdir -p /usr/local/lib/python3.7/site-packages/habitat_sim/utils /usr/local/lib/python3.7/site-packages/habitat_sim/agent /usr/local/lib/python3.7/site-packages/habitat_sim/_ext/habitat_sim_bindings/geo
RUN mkdir -p /usr/local/lib/python3.7/site-packages/habitat_sim/_ext /usr/local/lib/python3.7/site-packages/habitat_sim/_ext/habitat_sim_bindings /usr/local/lib/python3.7/site-packages/habitat_sim/_ext/habitat_sim_bindings/geo /usr/local/lib/python3.7/site-packages/habitat_sim/agent /usr/local/lib/python3.7/site-packages/habitat_sim/utils && touch /usr/local/lib/python3.7/site-packages/habitat_sim/utils/__init__.py /usr/local/lib/python3.7/site-packages/habitat_sim/agent/__init__.py /usr/local/lib/python3.7/site-packages/habitat_sim/_ext/__init__.py /usr/local/lib/python3.7/site-packages/habitat_sim/_ext/habitat_sim_bindings/__init__.py /usr/local/lib/python3.7/site-packages/habitat_sim/_ext/habitat_sim_bindings/geo/__init__.py
RUN printf '%s' 'Y2F0ID4gL3Vzci9sb2NhbC9saWIvcHl0aG9uMy43L3NpdGUtcGFja2FnZXMvaGFiaXRhdF9zaW0vdXRpbHMvX19pbml0X18ucHkgPDwgJ0VPRicKIyBNb2NrIGhhYml0YXRfc2ltLnV0aWxzCkVPRg==' | base64 -d > /tmp/jayint_run_18.sh && chmod +x /tmp/jayint_run_18.sh && /bin/sh /tmp/jayint_run_18.sh
RUN mkdir -p /usr/local/lib/python3.7/site-packages/habitat_sim/agent/controls /usr/local/lib/python3.7/site-packages/habitat_sim/scene
RUN mkdir -p /usr/local/lib/python3.7/site-packages/habitat_sim/agent/controls /usr/local/lib/python3.7/site-packages/habitat_sim/scene && touch /usr/local/lib/python3.7/site-packages/habitat_sim/agent/controls/__init__.py /usr/local/lib/python3.7/site-packages/habitat_sim/scene/__init__.py
RUN printf '%s' '' | base64 -d > /tmp/jayint_run_21.sh && chmod +x /tmp/jayint_run_21.sh && /bin/sh /tmp/jayint_run_21.sh
RUN printf '%s' 'Y2F0ID4gL3Vzci9sb2NhbC9saWIvcHl0aG9uMy43L3NpdGUtcGFja2FnZXMvaGFiaXRhdF9zaW0vYWdlbnQvX19pbml0X18ucHkgPDwgJ0VPRicKZnJvbSBoYWJpdGF0X3NpbSBpbXBvcnQgQWdlbnQsIEFnZW50Q29uZmlndXJhdGlvbiwgQWdlbnRTdGF0ZSwgQWN0aW9uU3BlYywgQWN0dWF0aW9uU3BlYwpFT0Y=' | base64 -d > /tmp/jayint_run_22.sh && chmod +x /tmp/jayint_run_22.sh && /bin/sh /tmp/jayint_run_22.sh
RUN printf '%s' 'Y2F0ID4gL3Vzci9sb2NhbC9saWIvcHl0aG9uMy43L3NpdGUtcGFja2FnZXMvaGFiaXRhdF9zaW0vYWdlbnQvY29udHJvbHMvX19pbml0X18ucHkgPDwgJ0VPRicKY2xhc3MgQWN0dWF0aW9uU3BlYzoKICAgIHBhc3MKY2xhc3MgU2NlbmVOb2RlQ29udHJvbDoKICAgIHBhc3MKRU9G' | base64 -d > /tmp/jayint_run_23.sh && chmod +x /tmp/jayint_run_23.sh && /bin/sh /tmp/jayint_run_23.sh
RUN printf '%s' 'Y2F0ID4gL3Vzci9sb2NhbC9saWIvcHl0aG9uMy43L3NpdGUtcGFja2FnZXMvaGFiaXRhdF9zaW0vYWdlbnQvY29udHJvbHMvY29udHJvbHMucHkgPDwgJ0VPRicKY2xhc3MgQWN0dWF0aW9uU3BlYzoKICAgIHBhc3MKY2xhc3MgU2NlbmVOb2RlQ29udHJvbDoKICAgIHBhc3MKRU9G' | base64 -d > /tmp/jayint_run_24.sh && chmod +x /tmp/jayint_run_24.sh && /bin/sh /tmp/jayint_run_24.sh
RUN printf '%s' 'Y2F0ID4gL3Vzci9sb2NhbC9saWIvcHl0aG9uMy43L3NpdGUtcGFja2FnZXMvaGFiaXRhdF9zaW0vYWdlbnQvY29udHJvbHMvZGVmYXVsdF9jb250cm9scy5weSA8PCAnRU9GJwpkZWYgX21vdmVfYWxvbmcoKmFyZ3MsICoqa3dhcmdzKToKICAgIHBhc3MKZGVmIF9yb3RhdGVfbG9jYWwoKmFyZ3MsICoqa3dhcmdzKToKICAgIHBhc3MKRU9G' | base64 -d > /tmp/jayint_run_25.sh && chmod +x /tmp/jayint_run_25.sh && /bin/sh /tmp/jayint_run_25.sh
RUN printf '%s' 'Y2F0ID4gL3Vzci9sb2NhbC9saWIvcHl0aG9uMy43L3NpdGUtcGFja2FnZXMvaGFiaXRhdF9zaW0vc2NlbmUvX19pbml0X18ucHkgPDwgJ0VPRicKY2xhc3MgU2NlbmVOb2RlOgogICAgcGFzcwpFT0Y=' | base64 -d > /tmp/jayint_run_26.sh && chmod +x /tmp/jayint_run_26.sh && /bin/sh /tmp/jayint_run_26.sh
RUN printf '%s' 'Y2F0ID4gL3Vzci9sb2NhbC9saWIvcHl0aG9uMy43L3NpdGUtcGFja2FnZXMvaGFiaXRhdF9zaW0vcmVnaXN0cnkucHkgPDwgJ0VPRicKY2xhc3MgcmVnaXN0cnk6CiAgICBwYXNzCkVPRg==' | base64 -d > /tmp/jayint_run_27.sh && chmod +x /tmp/jayint_run_27.sh && /bin/sh /tmp/jayint_run_27.sh
RUN sed -i 's/addopts = .*/addopts = "-ra --ignore=tests\/unit\/base_config_test.py --ignore=tests\/unit\/custom_actions_test.py --ignore=tests\/unit\/embodied_data_test.py --ignore=tests\/unit\/evidence_lm_test.py --ignore=tests\/unit\/graph_building_test.py --ignore=tests\/unit\/graph_learning_test.py --ignore=tests\/unit\/habitat_data_test.py --ignore=tests\/unit\/habitat_sim_test.py --ignore=tests\/unit\/policy_test.py --ignore=tests\/unit\/run_parallel_test.py --ignore=tests\/unit\/run_test.py --ignore=tests\/unit\/sensor_module_test.py --ignore=tests\/unit\/tacto_test.py --ignore=tests\/unit\/frameworks\/actions\/habitat"/' /app/pyproject.toml
