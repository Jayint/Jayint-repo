<?xml version="1.0" encoding="UTF-8"?>
<!--
  Combined model: DepGraph (prediction) seeds ContractGraph (runtime + memory).

  Two layers in ONE graph, joined by the `maps_to` edge (the entire integration):

    kind=dep      a-priori PREDICTION  — what the build will need (host-side,
                  never source of truth, consumed once at init).
    kind=contract live RUNTIME + MEMORY — the loop's control structure; host
                  certifies it, the Maintainer annotates it.

  Snapshot is MID-LOOP: `pip install opencv-python` already ran and came back
  ok_but_still_blocked (cv2 still fails on libGL) → that fix is marked
  ineffective; the deepest-unsatisfied frontier node is now syslib:libgl1, and
  the next deterministic action (apt:libgl1) is PROPOSED but not yet run.
-->
<graphml xmlns="http://graphml.graphdrawing.org/xmlns">
  <key id="d0" for="node" attr.name="label" attr.type="string"/>
  <key id="d1" for="node" attr.name="type" attr.type="string"/>
  <key id="d2" for="node" attr.name="layer" attr.type="string"/>
  <key id="d3" for="node" attr.name="state" attr.type="string"/>
  <key id="d4" for="node" attr.name="discovered_by" attr.type="string"/>
  <key id="d5" for="node" attr.name="check" attr.type="string"/>
  <key id="d6" for="node" attr.name="fix" attr.type="string"/>
  <key id="d7" for="node" attr.name="evidence" attr.type="string"/>
  <key id="d8" for="node" attr.name="build_from_source" attr.type="string"/>
  <key id="d9" for="node" attr.name="kind" attr.type="string"/>
  <key id="d10" for="node" attr.name="outcome" attr.type="string"/>
  <key id="d11" for="node" attr.name="status" attr.type="string"/>
  <key id="d12" for="node" attr.name="command" attr.type="string"/>
  <key id="d13" for="node" attr.name="note" attr.type="string"/>
  <key id="e0" for="edge" attr.name="relation" attr.type="string"/>
  <key id="e1" for="edge" attr.name="marker" attr.type="string"/>
  <key id="e2" for="edge" attr.name="constraint" attr.type="string"/>
  <graph edgedefault="directed">

    <!-- ============ DEP LAYER (prediction; fill = discovered_by) ============ -->
    <node id="test:repo_tests_pass">
      <data key="d0">repo_tests_pass</data>
      <data key="d1">Test</data>
      <data key="d2">tests</data>
      <data key="d3">missing</data>
      <data key="d4">goal</data>
      <data key="d9">dep</data>
      <data key="d5">python -m pytest -q</data>
      <data key="d7">collection error: import cv2 failed (libGL.so.1)</data>
    </node>
    <node id="import:cv2">
      <data key="d0">cv2</data>
      <data key="d1">Import</data>
      <data key="d2">naming</data>
      <data key="d3">missing</data>
      <data key="d4">static_scan</data>
      <data key="d9">dep</data>
      <data key="d5">python -c "import cv2"</data>
      <data key="d7">ImportError: libGL.so.1: cannot open shared object file: No such file or directory</data>
    </node>
    <node id="import:numpy">
      <data key="d0">numpy</data>
      <data key="d1">Import</data>
      <data key="d2">naming</data>
      <data key="d3">satisfied</data>
      <data key="d4">static_scan</data>
      <data key="d9">dep</data>
      <data key="d5">python -c "import numpy"</data>
    </node>
    <node id="pkg:opencv-python==4.9.0.80">
      <data key="d0">opencv-python==4.9.0.80</data>
      <data key="d1">Package</data>
      <data key="d2">pip</data>
      <data key="d3">satisfied</data>
      <data key="d4">resolver</data>
      <data key="d9">dep</data>
      <data key="d5">python -m pip show opencv-python</data>
      <data key="d6">pip:opencv-python</data>
      <data key="d8">false</data>
    </node>
    <node id="pkg:numpy==2.4.6">
      <data key="d0">numpy==2.4.6</data>
      <data key="d1">Package</data>
      <data key="d2">pip</data>
      <data key="d3">satisfied</data>
      <data key="d4">resolver</data>
      <data key="d9">dep</data>
      <data key="d5">python -m pip show numpy</data>
      <data key="d6">pip:numpy</data>
      <data key="d8">false</data>
    </node>
    <node id="syslib:libgl1">
      <data key="d0">libGL.so.1</data>
      <data key="d1">SystemLib</data>
      <data key="d2">system</data>
      <data key="d3">missing</data>
      <data key="d4">resolver</data>
      <data key="d9">dep</data>
      <data key="d5">ldconfig -p | grep libGL.so.1</data>
      <data key="d6">apt:libgl1</data>
      <data key="d13">FRONTIER: deepest unsatisfied node reachable from the root test goal.</data>
    </node>

    <!-- ====== CONTRACT LAYER (runtime + memory; fill = role) ====== -->
    <node id="contract:cv2-importable">
      <data key="d0">cv2 importable</data>
      <data key="d1">Contract</data>
      <data key="d2">naming</data>
      <data key="d9">contract</data>
      <data key="d11">open</data>
      <data key="d13">Seeded from import:cv2. Obligation: `import cv2` must succeed.</data>
    </node>
    <node id="contract:libGL-present">
      <data key="d0">libGL.so.1 present</data>
      <data key="d1">Contract</data>
      <data key="d2">system</data>
      <data key="d9">contract</data>
      <data key="d11">open</data>
      <data key="d13">Seeded from syslib:libgl1. Obligation: libGL.so.1 resolvable by the loader.</data>
    </node>
    <node id="blocker:missing-libGL">
      <data key="d0">libGL.so.1 missing</data>
      <data key="d1">Blocker</data>
      <data key="d2">system</data>
      <data key="d9">contract</data>
      <data key="d7">ImportError: libGL.so.1: cannot open shared object file</data>
      <data key="d13">Root native-layer cause; surfaced by certifying import:cv2 against the real container.</data>
    </node>
    <node id="attempt:pip-install-opencv">
      <data key="d0">pip install opencv-python</data>
      <data key="d1">Attempt</data>
      <data key="d2">pip</data>
      <data key="d9">contract</data>
      <data key="d10">ok_but_still_blocked</data>
      <data key="d12">python -m pip install opencv-python</data>
      <data key="d13">Install exited 0 but the node check `import cv2` still failed → fix marked INEFFECTIVE for contract:cv2-importable; next_action will not re-propose it.</data>
    </node>
    <node id="attempt:apt-install-libgl1">
      <data key="d0">apt install libgl1</data>
      <data key="d1">Attempt</data>
      <data key="d2">system</data>
      <data key="d9">contract</data>
      <data key="d10">proposed</data>
      <data key="d12">apt-get update &amp;&amp; apt-get install -y libgl1</data>
      <data key="d13">Next deterministic action: frontier node libGL.so.1 has untried-effective fix candidate apt:libgl1. Runs host-side, no Planner LLM.</data>
    </node>

    <!-- ============ DEP-LAYER requires edges (the prediction) ============ -->
    <edge source="test:repo_tests_pass" target="import:cv2"><data key="e0">requires</data></edge>
    <edge source="test:repo_tests_pass" target="import:numpy"><data key="e0">requires</data></edge>
    <edge source="import:cv2" target="pkg:opencv-python==4.9.0.80"><data key="e0">requires</data></edge>
    <edge source="import:numpy" target="pkg:numpy==2.4.6"><data key="e0">requires</data></edge>
    <edge source="pkg:opencv-python==4.9.0.80" target="pkg:numpy==2.4.6"><data key="e0">requires</data><data key="e1">python_full_version &lt; '3.12'</data></edge>
    <edge source="pkg:opencv-python==4.9.0.80" target="syslib:libgl1"><data key="e0">requires</data></edge>

    <!-- ============ CONTRACT-LAYER structure (runtime + memory) ============ -->
    <!-- depends_on: the seeded ORDERING — fix libGL before retrying cv2. -->
    <edge source="contract:cv2-importable" target="contract:libGL-present"><data key="e0">depends_on</data></edge>
    <!-- violates: blocker breaks the contract. -->
    <edge source="blocker:missing-libGL" target="contract:libGL-present"><data key="e0">violates</data></edge>
    <!-- addresses: attempts target contracts/blockers; outcome lives on the attempt node. -->
    <edge source="attempt:pip-install-opencv" target="contract:cv2-importable"><data key="e0">addresses</data></edge>
    <edge source="attempt:apt-install-libgl1" target="blocker:missing-libGL"><data key="e0">addresses</data></edge>

    <!-- ============ THE LINK: maps_to (the entire integration) ============ -->
    <edge source="contract:cv2-importable" target="import:cv2"><data key="e0">maps_to</data></edge>
    <edge source="contract:libGL-present" target="syslib:libgl1"><data key="e0">maps_to</data></edge>

  </graph>
</graphml>
