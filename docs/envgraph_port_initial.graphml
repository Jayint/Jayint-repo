<?xml version="1.0" encoding="UTF-8"?>
<!--
  EnvGraph-ported Dependency/Environment Graph — INITIAL (static-seed) snapshot.

  Built by the STATIC pass only (cold-start, before any command runs):
    - parse manifests (requirements.txt / pyproject / setup) -> declared packages
    - AST-scan *.py imports                                  -> used-in-code packages
    - known package->system-lib prior table                 -> syslib hint nodes
  Every dependency node here is a HYPOTHESIS: status="expected".
  Runtime probes have NOT run yet, so installed/importable/build_ok = "unknown".
  This mirrors EnvGraph's G_ext (Project -> File -> ExternalPackage, declares / file_imports),
  but in OUR use case the truth is only confirmed at runtime (see *_runtime.graphml).

  Worked repo "acme":
    requirements.txt declares: requests>=2.31, psycopg2, numpy
    src/app.py    imports: requests, psycopg2
    src/vision.py imports: cv2, numpy           (cv2 is imported but NOT declared)
-->
<graphml xmlns="http://graphml.graphdrawing.org/xmlns"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="node_type" for="node" attr.name="type" attr.type="string"/>
  <key id="label" for="node" attr.name="label" attr.type="string"/>
  <key id="kind" for="node" attr.name="kind" attr.type="string"/>
  <key id="layer" for="node" attr.name="layer" attr.type="string"/>
  <key id="source" for="node" attr.name="source" attr.type="string"/>            <!-- static | prior | runtime -->
  <key id="status" for="node" attr.name="status" attr.type="string"/>            <!-- expected | satisfied | violated | unknown -->
  <!-- STATIC attributes (written by the seed pass) -->
  <key id="declared" for="node" attr.name="declared" attr.type="string"/>
  <key id="imported" for="node" attr.name="imported" attr.type="string"/>
  <key id="version_spec" for="node" attr.name="version_spec" attr.type="string"/>
  <key id="syslib_hint" for="node" attr.name="syslib_hint" attr.type="string"/>
  <!-- RUNTIME attributes (unknown at init; populated in *_runtime.graphml) -->
  <key id="installed" for="node" attr.name="installed" attr.type="string"/>
  <key id="importable" for="node" attr.name="importable" attr.type="string"/>
  <key id="build_ok" for="node" attr.name="build_ok" attr.type="string"/>
  <key id="present" for="node" attr.name="present" attr.type="string"/>
  <key id="diagnosis" for="node" attr.name="diagnosis" attr.type="string"/>       <!-- deterministic blocker-kind read off the attr vector -->
  <key id="summary" for="node" attr.name="summary" attr.type="string"/>
  <key id="edge_type" for="edge" attr.name="type" attr.type="string"/>
  <key id="edge_label" for="edge" attr.name="label" attr.type="string"/>

  <graph id="envgraph_port_initial" edgedefault="directed">

    <!-- ===== EnvGraph-style structural layer (Project / Config / File) ===== -->
    <node id="env:project">
      <data key="node_type">Project</data><data key="label">acme</data>
      <data key="source">static</data><data key="status">expected</data>
      <data key="summary">Repository root being set up.</data>
    </node>
    <node id="config:requirements.txt">
      <data key="node_type">Config</data><data key="label">requirements.txt</data>
      <data key="kind">requirements</data><data key="source">static</data><data key="status">expected</data>
      <data key="summary">Declares requests&gt;=2.31, psycopg2, numpy.</data>
    </node>
    <node id="file:src/app.py">
      <data key="node_type">File</data><data key="label">src/app.py</data>
      <data key="source">static</data><data key="status">expected</data>
      <data key="summary">imports requests, psycopg2</data>
    </node>
    <node id="file:src/vision.py">
      <data key="node_type">File</data><data key="label">src/vision.py</data>
      <data key="source">static</data><data key="status">expected</data>
      <data key="summary">imports cv2, numpy</data>
    </node>

    <!-- ===== External package nodes (the "used vs declared" layer) ===== -->
    <node id="pkg:requests">
      <data key="node_type">ExternalPackage</data><data key="label">requests</data>
      <data key="kind">python_import</data><data key="layer">deps</data><data key="source">static</data>
      <data key="declared">true</data><data key="imported">true</data><data key="version_spec">&gt;=2.31</data>
      <data key="installed">unknown</data><data key="importable">unknown</data><data key="build_ok">unknown</data>
      <data key="status">expected</data>
      <data key="summary">declared AND imported; expect clean install.</data>
    </node>
    <node id="pkg:numpy">
      <data key="node_type">ExternalPackage</data><data key="label">numpy</data>
      <data key="kind">python_import</data><data key="layer">deps</data><data key="source">static</data>
      <data key="declared">true</data><data key="imported">true</data><data key="version_spec"></data>
      <data key="installed">unknown</data><data key="importable">unknown</data><data key="build_ok">unknown</data>
      <data key="status">expected</data>
      <data key="summary">declared AND imported; expect clean install.</data>
    </node>
    <node id="pkg:psycopg2">
      <data key="node_type">ExternalPackage</data><data key="label">psycopg2</data>
      <data key="kind">python_import</data><data key="layer">deps</data><data key="source">static</data>
      <data key="declared">true</data><data key="imported">true</data><data key="version_spec"></data>
      <data key="syslib_hint">libpq-dev</data>
      <data key="installed">unknown</data><data key="importable">unknown</data><data key="build_ok">unknown</data>
      <data key="status">expected</data>
      <data key="summary">declared+imported; source build -> PRIOR warns it needs libpq-dev.</data>
    </node>
    <node id="pkg:cv2">
      <data key="node_type">ExternalPackage</data><data key="label">cv2</data>
      <data key="kind">python_import</data><data key="layer">deps</data><data key="source">static</data>
      <data key="declared">false</data><data key="imported">true</data><data key="version_spec"></data>
      <data key="syslib_hint">libGL.so.1</data>
      <data key="installed">unknown</data><data key="importable">unknown</data><data key="build_ok">unknown</data>
      <data key="status">expected</data>
      <data key="diagnosis">module_not_found (imported but NOT declared)</data>
      <data key="summary">STATIC DIFF flags this pre-run: used_in_code=true AND declared=false.</data>
    </node>

    <!-- ===== System-library priors (seeded from package->syslib table) ===== -->
    <node id="syslib:libpq-dev">
      <data key="node_type">SystemLib</data><data key="label">libpq-dev</data>
      <data key="kind">system_library</data><data key="layer">system</data><data key="source">prior</data>
      <data key="present">unknown</data><data key="status">unknown</data>
      <data key="summary">PRIOR: psycopg2 source build requires pg_config/libpq headers.</data>
    </node>
    <node id="syslib:libGL.so.1">
      <data key="node_type">SystemLib</data><data key="label">libGL.so.1</data>
      <data key="kind">system_library</data><data key="layer">system</data><data key="source">prior</data>
      <data key="present">unknown</data><data key="status">unknown</data>
      <data key="summary">PRIOR: opencv runtime needs the native OpenGL shared object.</data>
    </node>

    <!-- ===== Structural edges (EnvGraph G_ext shape) ===== -->
    <edge id="s1" source="env:project" target="config:requirements.txt"><data key="edge_type">project_contains</data><data key="edge_label">contains</data></edge>
    <edge id="s2" source="env:project" target="file:src/app.py"><data key="edge_type">project_contains</data><data key="edge_label">contains</data></edge>
    <edge id="s3" source="env:project" target="file:src/vision.py"><data key="edge_type">project_contains</data><data key="edge_label">contains</data></edge>

    <edge id="d1" source="config:requirements.txt" target="pkg:requests"><data key="edge_type">declares</data><data key="edge_label">declares</data></edge>
    <edge id="d2" source="config:requirements.txt" target="pkg:psycopg2"><data key="edge_type">declares</data><data key="edge_label">declares</data></edge>
    <edge id="d3" source="config:requirements.txt" target="pkg:numpy"><data key="edge_type">declares</data><data key="edge_label">declares</data></edge>

    <edge id="i1" source="file:src/app.py" target="pkg:requests"><data key="edge_type">file_imports</data><data key="edge_label">imports</data></edge>
    <edge id="i2" source="file:src/app.py" target="pkg:psycopg2"><data key="edge_type">file_imports</data><data key="edge_label">imports</data></edge>
    <edge id="i3" source="file:src/vision.py" target="pkg:cv2"><data key="edge_type">file_imports</data><data key="edge_label">imports (undeclared!)</data></edge>
    <edge id="i4" source="file:src/vision.py" target="pkg:numpy"><data key="edge_type">file_imports</data><data key="edge_label">imports</data></edge>

    <!-- system-lib priors: package depends_on syslib (hypothesis, from prior table) -->
    <edge id="p1" source="pkg:psycopg2" target="syslib:libpq-dev"><data key="edge_type">depends_on</data><data key="edge_label">needs (prior)</data></edge>
    <edge id="p2" source="pkg:cv2" target="syslib:libGL.so.1"><data key="edge_type">depends_on</data><data key="edge_label">needs (prior)</data></edge>

  </graph>
</graphml>
