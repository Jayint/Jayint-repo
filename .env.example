LLM_API_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Pin OpenRouter to a specific upstream provider (comma-separated; default "Alibaba").
# Leave empty to let OpenRouter auto-route. Alibaba = Alibaba Cloud Int. (SG), low-latency for deepseek-v4-flash.
OPENROUTER_PROVIDER=Alibaba

# Provider precedence in agent.py is OpenRouter -> MiniMax -> OpenAI (all OpenAI-compatible).
# Backward-compatible alternatives (leave the OpenRouter block empty if you use these):
# MINIMAX_API_KEY=
# MINIMAX_API_BASE=
# OPENAI_API_KEY=
# OPENAI_API_BASE=
